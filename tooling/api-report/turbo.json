{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test:unit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/tooling/*/package.json",
        "$TURBO_ROOT$/examples/*/package.json",
        "$TURBO_ROOT$/examples/*/*/*/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/.changeset/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/tooling/api-report/reports/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/tooling/*/package.json",
        "$TURBO_ROOT$/examples/*/package.json",
        "$TURBO_ROOT$/examples/*/*/*/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/.changeset/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/tooling/api-report/reports/**"
      ]
    }
  }
}
