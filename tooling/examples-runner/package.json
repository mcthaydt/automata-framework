{
  "name": "@mcthaydt/examples-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog.ts",
    "./smoke": "./src/smoke.ts",
    "./host/ports": "./host/ports.ts",
    "./host/preview-headers": "./host/preview-headers.ts",
    "./host/testing": "./host/testing.ts"
  },
  "bin": {
    "automata-examples": "./src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project node",
    "test:parity": "vitest run --project browsers",
    "typecheck": "tsc -p .",
    "e2e:host": "vite build -c host/vite.config.ts && vite preview -c host/vite.config.ts --strictPort --host 127.0.0.1 --port $AF_E2E_DEMO_HOST_PORT",
    "e2e:fixtures": "vite build -c fixtures.vite.config.ts && vite preview -c fixtures.vite.config.ts --strictPort --host localhost --port $AF_E2E_EXAMPLES_PORT"
  },
  "dependencies": {
    "@mcthaydt/automata-render-pixi": "workspace:*",
    "@mcthaydt/automata-ship": "workspace:*",
    "@mcthaydt/automata-sim": "workspace:*",
    "@ruken/manifest": "file:../../vendor/ruken/ruken-manifest-0.0.0.tgz",
    "@ruken/sdk-host": "file:../../vendor/ruken/ruken-sdk-host-0.0.0.tgz",
    "effect": "3.22.2",
    "oxc-parser": "0.152.0"
  },
  "devDependencies": {
    "@mcthaydt/automata-testing": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
