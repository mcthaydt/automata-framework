{
  "name": "@automataframework/examples-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog": "./src/catalog.ts",
    "./smoke": "./src/smoke.ts",
    "./host/ports": "./host/ports.ts",
    "./host/preview-headers": "./host/preview-headers.ts",
    "./host/testing": "./host/testing.ts",
    "./header": "./src/header.ts",
    "./page-template": "./src/page-template.ts",
    "./examples-ship-config": "./src/examples-ship-config.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "bin": {
    "automata-examples": "./src/cli.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc -p .",
    "e2e:host": "vite build -c host/vite.config.ts && vite preview -c host/vite.config.ts --strictPort --host 127.0.0.1 --port $AF_E2E_DEMO_HOST_PORT",
    "e2e:fixtures": "vite build -c fixtures.vite.config.ts && vite preview -c fixtures.vite.config.ts --strictPort --host localhost --port $AF_E2E_EXAMPLES_PORT"
  },
  "dependencies": {
    "@automataframework/automata": "workspace:*",
    "@automataframework/automata-sim": "workspace:*",
    "@automataframework/automata-tools": "workspace:*",
    "@ruken/sdk-host": "file:../../vendor/ruken/ruken-sdk-host-0.0.0.tgz",
    "effect": "3.22.2",
    "oxc-parser": "0.152.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@automataframework/vitest-preset": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "koota": "0.6.6",
    "svelte": "5.57.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
