{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tooling/release/src/publishable-packages.ts"]
    },
    "test:unit": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/SECURITY.md",
        "$TURBO_ROOT$/.github/CODEOWNERS",
        "$TURBO_ROOT$/docs/runbook.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/knip.jsonc",
        "$TURBO_ROOT$/lefthook.yml",
        "$TURBO_ROOT$/.gitleaks.toml",
        "$TURBO_ROOT$/packages/ship/src/prepare/secret-scan.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/tooling/*/package.json",
        "$TURBO_ROOT$/games/*/package.json",
        "$TURBO_ROOT$/examples/*/package.json",
        "$TURBO_ROOT$/examples/*/*/package.json",
        "$TURBO_ROOT$/tooling/release/src/publishable-packages.ts"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/SECURITY.md",
        "$TURBO_ROOT$/.github/CODEOWNERS",
        "$TURBO_ROOT$/docs/runbook.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/knip.jsonc",
        "$TURBO_ROOT$/lefthook.yml",
        "$TURBO_ROOT$/.gitleaks.toml",
        "$TURBO_ROOT$/packages/ship/src/prepare/secret-scan.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/tooling/*/package.json",
        "$TURBO_ROOT$/games/*/package.json",
        "$TURBO_ROOT$/examples/*/package.json",
        "$TURBO_ROOT$/examples/*/*/package.json",
        "$TURBO_ROOT$/tooling/release/src/publishable-packages.ts"
      ]
    }
  }
}
