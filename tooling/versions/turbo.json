      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/tooling/*/package.json",
        "$TURBO_ROOT$/games/*/package.json",
        "$TURBO_ROOT$/examples/*/package.json",
        "$TURBO_ROOT$/examples/*/*/package.json",
        "$TURBO_ROOT$/docs/versions.md",
        "$TURBO_ROOT$/docs/stack.md",
        "$TURBO_ROOT$/vendor/ruken/README.md",
        "$TURBO_ROOT$/pnpm-lock.yaml",
        "$TURBO_ROOT$/.nvmrc"
