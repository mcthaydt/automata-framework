{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // Games are not published libraries (games/emberwick sets the same), so the example is checked as a game is.
    "isolatedDeclarations": false,
    // The automata-feature example (outside this package) resolves its imports as a game would.
    "paths": {
      "@automata/sim": ["../../packages/sim/src/entries/index.ts"],
      "zod": ["./node_modules/zod"],
      "vitest": ["./node_modules/vitest"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "../../agents/automata/skills/*/example/**/*.ts"]
}
