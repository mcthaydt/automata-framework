// Copied from mcthaydt/automata-framework at b7ef19d978d4751eaf08d1374dcfbcf2459d8c2b (its biome.json; renamed .jsonc
// here so it can hold this comment). The formatter and linter settings are unchanged. Changed: the excludes name only
// folders Plus has (AF's fixture folders are gone), and AF's packages/sim override is dropped (Plus has no
// packages/sim). .core/ is skipped through .gitignore.
{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/dist", "!**/out", "!**/__goldens__"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      // M6.6a, M6.7a, M6.8a: an action's or a rule's effects are its `then` member, the contract's own name (M6 spec §4.5 and
      // §4.6 keep the contracts' shape), so a def is an object with a `then` key. No such object is ever awaited.
      "includes": ["packages/narrative/**", "packages/puzzle/**", "packages/systems/**"],
      "linter": { "rules": { "suspicious": { "noThenProperty": "off" } } }
    }
  ]
}
