{
  "name": "@automata/3d",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "AF's 3D: the Pixi 3D renderer and camera, procedural figures, the level format and the world, by feature. Private until Pixi 3D is public.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/3d"
  },
  "type": "module",
  "sideEffects": [
    "./src/entries/no-eval.ts",
    "./src/features/figures/outfit/garments/classic-kinds.ts",
    "./src/features/renderer/no-eval/install-no-eval.ts"
  ],
  "exports": {
    ".": "./src/entries/index.ts",
    "./camera-view": "./src/entries/camera-view.ts",
    "./figures": "./src/entries/figures.ts",
    "./figures-kit": "./src/entries/figures-kit.ts",
    "./level": "./src/entries/level.ts",
    "./no-eval": "./src/entries/no-eval.ts",
    "./world-content": "./src/entries/world-content.ts",
    "./sim": "./src/entries/sim.ts",
    "./testing": "./src/entries/testing.ts",
    "./testing-checks": "./src/entries/testing-checks.ts",
    "./timeline": "./src/entries/timeline.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "automata": {
    "simEntries": [
      "./sim",
      "./level",
      "./timeline"
    ]
  },
  "scripts": {
    "goldens": "node --import ./scripts/extensionless-ts.ts scripts/record-goldens.ts",
    "bench": "AF_BENCH=1 vitest run --project bench",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@automata/content": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/sim": "workspace:*",
    "@pixi/3d": "file:../../vendor/pixi-3d/pixi-3d-0.1.0-beta.2.tgz",
    "@pmndrs/klipp": "0.16.0",
    "smol-toml": "1.9.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@automata/vitest-preset": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "pixi.js": "8.22.0",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
