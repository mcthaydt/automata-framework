{
  "name": "@mcthaydt/automata-tools",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/tools"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "VENDORED.md"
  ],
  "exports": {
    ".": "./src/entries/index.ts",
    "./e2e": "./src/entries/e2e.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "bin": {
    "automata": "./src/app/bin.ts",
    "automata-ship": "./src/app/ship-alias-bin.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./e2e": {
        "types": "./dist/e2e.d.ts",
        "import": "./dist/e2e.js"
      }
    },
    "bin": {
      "automata": "./dist/bin.js",
      "automata-ship": "./dist/ship-alias-bin.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "typecheck": "tsc -p .",
    "build": "tsdown",
    "check:example": "node src/app/bin.ts check ../../games/emberwick --csp",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mcthaydt/automata-check-boundaries": "workspace:*",
    "@mcthaydt/automata-content": "workspace:*",
    "effect": "3.22.2",
    "oxc-parser": "0.152.0",
    "semver": "7.8.5",
    "smol-toml": "1.9.0",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mcthaydt/automata-editor-suite": "workspace:*",
    "@mcthaydt/playwright-preset": "workspace:*",
    "@mcthaydt/vitest-preset": "workspace:*",
    "@playwright/test": "1.63.0",
    "@ruken/cli": "file:../../vendor/ruken/ruken-cli-0.0.0.tgz",
    "@ruken/manifest": "file:../../vendor/ruken/ruken-manifest-0.0.0.tgz",
    "@types/node": "24.19.1",
    "@types/semver": "7.8.0",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
