{
  "name": "@automataframework/automata-sector-format",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/sector-format"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./blockout": "./blockout/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./blockout": {
        "types": "./dist/blockout.d.ts",
        "import": "./dist/blockout.js"
      }
    }
  },
  "automata": {
    "simEntries": [
      "."
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc -p .",
    "build": "tsdown"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "vitest": "5.0.3"
  }
}
