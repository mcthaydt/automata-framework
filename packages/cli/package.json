{
  "name": "@mcthaydt/automata-cli",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "automata": "./bin/create-game.js",
    "create-game": "./bin/create-game.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc -p .",
    "build": "tsdown",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "check:example": "node src/bin.ts check ../../games/emberwick --csp"
  },
  "dependencies": {
    "@mcthaydt/automata-node": "workspace:*",
    "@mcthaydt/automata-ship": "workspace:*",
    "effect": "3.22.2",
    "oxc-parser": "0.152.0",
    "semver": "7.8.5",
    "smol-toml": "1.9.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@mcthaydt/automata-editor-suite": "workspace:*",
    "@ruken/manifest": "file:../../vendor/ruken/ruken-manifest-0.0.0.tgz",
    "@types/node": "24.19.1",
    "@types/semver": "7.8.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
