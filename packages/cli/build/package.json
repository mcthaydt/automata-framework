    "zod": "4.6.6",
    "@ruken/sdk": "^0.0.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-store": "2.5.0"
  },
  "devDependencies": {
    "@mcthaydt/automata-ship": "workspace:*",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "@tauri-apps/cli": "2.12.3"
