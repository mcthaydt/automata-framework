{
  "name": "@mcthaydt/automata-host",
  "version": "0.0.4",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/host"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "VENDORED.md"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./target": {
      "automata-web": "./src/target-web.ts",
      "default": "./src/target-ruken.ts"
    },
    "./testing": "./src/testing/index.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./target": {
        "automata-web": {
          "types": "./dist/target-web.d.ts",
          "import": "./dist/target-web.js"
        },
        "default": {
          "types": "./dist/target.d.ts",
          "import": "./dist/target.js"
        }
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc -p .",
    "build": "tsdown"
  },
  "dependencies": {
    "effect": "3.22.2",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@ruken/sdk": "file:../../vendor/ruken/ruken-sdk-0.0.0.tgz",
    "@ruken/sdk-host": "file:../../vendor/ruken/ruken-sdk-host-0.0.0.tgz",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
