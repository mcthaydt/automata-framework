{
  "name": "@automataframework/automata-content",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/content"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "VENDORED.md"
  ],
  "exports": {
    ".": "./src/entries/index.ts",
    "./assets": "./src/entries/assets.ts",
    "./game-config": "./src/entries/game-config.ts",
    "./level-2d": "./src/entries/level-2d.ts",
    "./locale": "./src/entries/locale.ts",
    "./palette": "./src/entries/palette.ts",
    "./schema": "./src/entries/schema.ts",
    "./vite": "./src/entries/vite.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "automata": {
    "simEntries": [
      "./level-2d"
    ]
  },
  "bin": {
    "automata-content": "./src/app/cli/main.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./assets": {
        "types": "./dist/assets.d.ts",
        "import": "./dist/assets.js"
      },
      "./game-config": {
        "types": "./dist/game-config.d.ts",
        "import": "./dist/game-config.js"
      },
      "./level-2d": {
        "types": "./dist/level-2d.d.ts",
        "import": "./dist/level-2d.js"
      },
      "./locale": {
        "types": "./dist/locale.d.ts",
        "import": "./dist/locale.js"
      },
      "./palette": {
        "types": "./dist/palette.d.ts",
        "import": "./dist/palette.js"
      },
      "./schema": {
        "types": "./dist/schema.d.ts",
        "import": "./dist/schema.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "import": "./dist/vite.js"
      }
    },
    "bin": {
      "automata-content": "./dist/cli.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc -p .",
    "build": "tsdown"
  },
  "dependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-message-format": "4.4.4",
    "@automataframework/automata-sim": "workspace:*",
    "effect": "3.22.2",
    "fontkit": "2.0.4",
    "pngjs": "7.0.0",
    "smol-toml": "1.9.0",
    "subset-font": "2.9.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "vite": "^8.3.3"
  },
  "devDependencies": {
    "@automataframework/vitest-preset": "workspace:*",
    "@ruken/manifest": "file:../../vendor/ruken/ruken-manifest-0.0.0.tgz",
    "@types/fontkit": "2.0.9",
    "@types/node": "24.19.1",
    "@types/pngjs": "6.0.5",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
