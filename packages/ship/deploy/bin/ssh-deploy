#!/usr/bin/env bash
# The forced command of the dev host's `deploy` key (ship spec §3.5). In ~deploy/.ssh/authorized_keys:
#   command="/usr/local/lib/automata/bin/ssh-deploy",no-pty,no-port-forwarding,no-agent-forwarding,no-X11-forwarding ssh-ed25519 AAAA... ci
# Whatever the client asks to run, the key can only install a build read from stdin, optionally making it
# live. Adapted from FloorFifty's staging key (docs/release.md), which can only install a release.
set -euo pipefail

deploy="${SHIP_DEPLOY:-/usr/local/lib/automata/bin/deploy}"
case "${SSH_ORIGINAL_COMMAND:-}" in
  deploy) exec sudo -n "$deploy" - ;;
  "deploy --activate") exec sudo -n "$deploy" - --activate ;;
  *)
    echo "this key runs only 'deploy' or 'deploy --activate', with the build tarball on stdin" >&2
    exit 2
    ;;
esac
