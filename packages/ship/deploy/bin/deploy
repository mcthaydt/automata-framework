#!/usr/bin/env bash
# Installs one AF game build on the standalone dev host (ship spec §3.5, decision D-4), and with --activate
# makes it the one / redirects to. Adapted from FloorFifty deploy/bin/deploy, cut down to static builds.
#
# Usage: deploy <build.tgz|-> [--activate]      (- reads the tarball from stdin, as over ssh)
#
# The tarball is `ship deploy-dev`'s: build.json ({ buildId, commit, tag, branch }), headers.json
# ({ headers, entry }, Ruken's compileHeaders for this build) and client/ (the prepared game folder).
# Each build gets /builds/<id>/ and keeps it: an installed ID is never replaced, so a URL always shows the
# same build. The new config is checked with `caddy validate` before `caddy reload`; if Caddy rejects it,
# the new build is removed and the previous live build stays live.
#
# Environment: SHIP_ROOT (the game's folder, default /srv/automata/game), SHIP_BASE_URL (the site's URL,
# for builds-index.json), CADDY (default caddy), CADDYFILE (default /etc/caddy/Caddyfile),
# SHIP_DEPLOY_LOCK_WAIT (seconds to wait for another deploy, default 120). Tests point SHIP_DEV_HOST_ENV and
# SHIP_CADDY_ENV at their own files; on the host sudo drops both and the defaults below apply.
#
# The tarball is untrusted: it may hold only regular files and folders, all inside the build folder. A symlink,
# hard link, device or a member named with .. or an absolute path is refused before anything is extracted,
# because Caddy would serve whatever such a member points at. The tarball's owners and modes are ignored.
#
# Exit codes: 2 not a build, an unsafe tarball or refused headers, 3 ID already installed, 4 Caddy rejected
# the config, 5 another deploy held the lock for too long, 6 Caddy failed to reload (the previous live build
# is put back), 7 caddy.env and the dev host settings name different game folders.
set -euo pipefail

# On the host the settings live in one file (deploy/README.md); a caller that sets SHIP_ROOT (the tests) skips it.
dev_host_env="${SHIP_DEV_HOST_ENV:-/etc/automata/dev-host.env}"
if [[ -z "${SHIP_ROOT:-}" && -r "$dev_host_env" ]]; then
  set -a
  # shellcheck source=/dev/null
  . "$dev_host_env"
  set +a
fi

# `caddy validate` and `caddy reload` adapt the Caddyfile in this process, so {$AF_DEV_SITE}, {$SHIP_ROOT} and
# {$AF_ACME_EMAIL} come from this process's environment. caddy.service has them from caddy.env (FloorFifty's
# deploy/caddy/caddy-env.conf); a sudo from the deploy user does not, and Caddy would then refuse every deploy
# (FloorFifty's first staging deploy was refused over an empty `email`; deploy/bin/activate there).
caddy_env="${SHIP_CADDY_ENV:-/etc/floor-fifty/caddy.env}"
ship_root_before="${SHIP_ROOT:-}"
if [[ -r "$caddy_env" ]]; then
  set -a
  # shellcheck source=/dev/null
  . "$caddy_env"
  set +a
fi
# caddy.env also sets SHIP_ROOT, for the Caddyfile. If it named another folder than the dev host settings, the
# build would land where Caddy does not look; refuse rather than pick one.
if [[ -n "$ship_root_before" && "${SHIP_ROOT:-}" != "$ship_root_before" ]]; then
  echo "SHIP_ROOT is $ship_root_before in the dev host settings but ${SHIP_ROOT:-empty} in $caddy_env; make them agree" >&2
  exit 7
fi

root="${SHIP_ROOT:-/srv/automata/game}"
base_url="${SHIP_BASE_URL:?SHIP_BASE_URL is the dev host URL, e.g. https://af-dev.example.org}"
caddy="${CADDY:-caddy}"
caddyfile="${CADDYFILE:-/etc/caddy/Caddyfile}"
bin="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source_tgz="${1:?usage: deploy <build.tgz|-> [--activate]}"
activate=0
[[ "${2:-}" == "--activate" ]] && activate=1

mkdir -p "$root/builds"

# One deploy at a time per game: two at once could both read the old live.caddy and one Caddy reload could
# pick up the other's half-installed build. The lock is released when this process exits.
exec 9> "$root/.deploy.lock"
if ! flock -w "${SHIP_DEPLOY_LOCK_WAIT:-120}" 9; then
  echo "another deploy is still running for $root; try again when it finishes" >&2
  exit 5
fi

[[ -f "$root/live.caddy" ]] || : > "$root/live.caddy"

incoming="$(mktemp -d "$root/builds/.incoming.XXXXXX")"
archive="$incoming.tgz"
cleanup() { rm -rf "$incoming" "$archive"; }
trap cleanup EXIT
refuse() {
  echo "$1" >&2
  exit 2
}
# Keep the tarball in a file: it is listed (checked) and then extracted, and stdin can be read only once.
if [[ "$source_tgz" == "-" ]]; then
  cat > "$archive"
else
  cp "$source_tgz" "$archive"
fi

# Check every member before extracting any. In `tar -tv` output the first character of a line is the
# member's type: - a regular file, d a folder; anything else (l symlink, h hard link, c/b/p devices and
# fifos) is refused. GNU tar escapes newlines in names, so one member is one line.
listing="$(tar -tvzf "$archive" 2> /dev/null)" || refuse "not a gzip tar archive"
while IFS= read -r line; do
  [[ -z "$line" || "$line" == -* || "$line" == d* ]] ||
    refuse "a build may hold only regular files and folders; refused: $line"
done <<< "$listing"
names="$(tar -tzf "$archive")"
while IFS= read -r name; do
  if [[ "$name" == /* || "$name" =~ (^|/)\.\.(/|$) ]]; then
    refuse "a build member is outside the build folder; refused: $name"
  fi
done <<< "$names"

# --no-same-owner and --no-same-permissions: as root, tar would otherwise keep the archive's uid and modes
# (setuid bits included).
tar -xzf "$archive" -C "$incoming" --no-same-owner --no-same-permissions
# The listing already allowed only files and folders; check what landed too, in case tar and this script
# ever read an entry differently.
if [[ -n "$(find "$incoming" ! -type f ! -type d -print -quit)" ]]; then
  refuse "a build may hold only regular files and folders"
fi
# Caddy runs as its own user, so everything must be readable by others (mktemp makes the folder 0700, and
# FloorFifty's staging answered 403 for that); nothing is writable by others, executable as a file or setuid.
chmod -R u=rwX,go=rX "$incoming"
find "$incoming" -type f -exec chmod 644 {} +

id=""
if [[ -f "$incoming/build.json" ]]; then
  id="$(node -e 'const b = require(process.argv[1]); process.stdout.write(String(b.buildId ?? ""))' "$incoming/build.json")"
fi
if [[ ! "$id" =~ ^[0-9]{12}-[0-9a-f]{7,40}$ || ! -d "$incoming/client" || ! -f "$incoming/headers.json" ]]; then
  echo "not a ship build: build.json must name a build ID, with headers.json and client/ beside it" >&2
  exit 2
fi
if [[ -e "$root/builds/$id" ]]; then
  echo "build $id is already installed; a build ID is never replaced" >&2
  exit 3
fi

# The host writes the Caddy snippet itself from headers.json and refuses unsafe values (render-headers.ts).
if ! node "$bin/render-headers.ts" "$id" "$incoming/headers.json" > "$incoming/headers.caddy"; then
  echo "headers.json for $id was refused" >&2
  exit 2
fi

mv "$incoming" "$root/builds/$id"
rm -f "$archive"
trap - EXIT

previous_live_caddy="$(cat "$root/live.caddy")"
previous_live="$(cat "$root/live" 2>/dev/null || true)"

# Writes a file through a temporary file and a rename, so Caddy or builds-index never read half of it.
write_file() {
  local path="$1" contents="$2"
  printf '%s' "$contents" > "$path.tmp"
  mv "$path.tmp" "$path"
}
put_back_previous() {
  rm -rf "${root:?}/builds/$id"
  write_file "$root/live.caddy" "${previous_live_caddy:+$previous_live_caddy$'\n'}"
  if [[ -n "$previous_live" ]]; then write_file "$root/live" "$previous_live"$'\n'; else rm -f "$root/live"; fi
}

if (( activate )); then
  write_file "$root/live.caddy" "redir / /builds/$id/ 302"$'\n'
  write_file "$root/live" "$id"$'\n'
fi

if ! "$caddy" validate --config "$caddyfile" --adapter caddyfile; then
  put_back_previous
  echo "caddy rejected the config with build $id; it was removed and nothing else changed" >&2
  exit 4
fi
if ! "$caddy" reload --config "$caddyfile" --adapter caddyfile; then
  # Caddy may still run the old config, or may have taken part of the new one. Put the files back and reload
  # again, so the running Caddy and the next restart both serve the previous live build.
  put_back_previous
  if "$caddy" reload --config "$caddyfile" --adapter caddyfile; then
    echo "caddy failed to reload with build $id; it was removed and the previous config is back" >&2
  else
    echo "caddy failed to reload with build $id and again with the previous config; check caddy.service" >&2
  fi
  exit 6
fi

node "$bin/builds-index.ts" "$root" "$base_url" 10 > "$root/.builds-index.json.tmp"
mv "$root/.builds-index.json.tmp" "$root/builds-index.json"

echo "build $id is at $base_url/builds/$id/$( (( activate )) && echo ' and is live at /')"
