{
  "name": "@mcthaydt/automata-testing",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./sim": "./src/sim/index.ts",
    "./sim/commands": "./src/sim/commands.ts",
    "./sim/property": "./src/sim/property.ts",
    "./input": "./src/input/fake-gamepads.ts",
    "./host": "./src/host/index.ts",
    "./e2e": "./src/e2e/index.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./sim": {
        "types": "./dist/sim/index.d.ts",
        "import": "./dist/sim/index.js"
      },
      "./sim/commands": {
        "types": "./dist/sim/commands.d.ts",
        "import": "./dist/sim/commands.js"
      },
      "./sim/property": {
        "types": "./dist/sim/property.d.ts",
        "import": "./dist/sim/property.js"
      },
      "./input": {
        "types": "./dist/input/fake-gamepads.d.ts",
        "import": "./dist/input/fake-gamepads.js"
      },
      "./host": {
        "types": "./dist/host/index.d.ts",
        "import": "./dist/host/index.js"
      },
      "./e2e": {
        "types": "./dist/e2e/index.d.ts",
        "import": "./dist/e2e/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project sim",
    "test:layout": "vitest run --project layout",
    "test:parity": "vitest run --project layout --project sim-browsers",
    "test:evidence": "vitest run --project sim --project sim-browsers src/sim/bounce.golden.test.ts --reporter=default --reporter=json --outputFile.json=.evidence/goldens.json",
    "typecheck": "tsc -p .",
    "build": "tsdown"
  },
  "dependencies": {
    "@mcthaydt/automata-host": "workspace:*",
    "@mcthaydt/automata-sim": "workspace:*",
    "effect": "3.22.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@playwright/test": "^1.63.0",
    "svelte": "^5.57.1",
    "vitest": "^5.0.3"
  },
  "devDependencies": {
    "@mcthaydt/evidence": "workspace:*",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
