{
  "name": "@mcthaydt/automata-render-pixi",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/render-pixi"
  },
  "type": "module",
  "sideEffects": [
    "./src/no-eval.ts",
    "./dist/no-eval.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./no-eval": "./src/no-eval.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./no-eval": {
        "types": "./dist/no-eval.d.ts",
        "import": "./dist/no-eval.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc -p .",
    "build": "tsdown"
  },
  "dependencies": {
    "@mcthaydt/automata-runtime": "workspace:*",
    "@mcthaydt/automata-sim": "workspace:*",
    "@mcthaydt/automata-ui": "workspace:*",
    "effect": "3.22.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "pixi.js": "^8.22.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@mcthaydt/automata-testing": "workspace:*",
    "@mcthaydt/vitest-preset": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "pixi.js": "8.22.0",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
