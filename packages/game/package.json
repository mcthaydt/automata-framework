{
  "name": "@mcthaydt/automata-game",
  "version": "0.0.3",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/game"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.svelte",
    "./src/no-eval.ts",
    "./dist/no-eval.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./no-eval": "./src/no-eval.ts",
    "./tooling": "./src/tooling.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "import": "./dist/index.js"
      },
      "./no-eval": {
        "types": "./dist/no-eval.d.ts",
        "import": "./dist/no-eval.js"
      },
      "./tooling": {
        "types": "./dist/tooling.d.ts",
        "import": "./dist/tooling.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:parity": "vitest run --project browsers --project layout",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "svelte-package -i src -o dist --tsconfig tsconfig.package.json && node build/finish-dist.ts"
  },
  "dependencies": {
    "@mcthaydt/automata-content": "workspace:*",
    "@mcthaydt/automata-host": "workspace:*",
    "@mcthaydt/automata-render-pixi": "workspace:*",
    "@mcthaydt/automata-runtime": "workspace:*",
    "@mcthaydt/automata-sim": "workspace:*",
    "@mcthaydt/automata-ui": "workspace:*",
    "effect": "3.22.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "pixi.js": "^8.22.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@mcthaydt/automata-testing": "workspace:*",
    "@ruken/sdk-host": "file:../../vendor/ruken/ruken-sdk-host-0.0.0.tgz",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "pixi.js": "8.22.0",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
