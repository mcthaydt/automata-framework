{
  "name": "@mcthaydt/automata-sim",
  "version": "0.0.2",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/sim"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./hash": "./src/hash/hash.ts",
    "./math": "./src/math/dmath.ts",
    "./replay": "./src/replay/index.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./hash": {
        "types": "./dist/hash.d.ts",
        "import": "./dist/hash.js"
      },
      "./math": {
        "types": "./dist/math.d.ts",
        "import": "./dist/math.js"
      },
      "./replay": {
        "types": "./dist/replay.d.ts",
        "import": "./dist/replay.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run --project node --project browsers",
    "bench": "vitest run --project bench",
    "test:unit": "vitest run --project node",
    "typecheck": "tsc -p .",
    "test:parity": "vitest run --project browsers",
    "test:evidence": "vitest run --project node --project browsers src/world/snapshot.parity.test.ts --reporter=default --reporter=json --outputFile.json=.evidence/goldens.json",
    "build": "tsdown"
  },
  "dependencies": {
    "koota": "0.6.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mcthaydt/evidence": "workspace:*",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0",
    "vitest": "5.0.3"
  }
}
