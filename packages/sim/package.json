{
  "name": "@automata/sim",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/sim"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/entries/index.ts",
    "./hash": "./src/entries/hash.ts",
    "./math": "./src/entries/math.ts",
    "./replay": "./src/entries/replay.ts",
    "./testing": "./src/entries/testing.ts",
    "./testing/commands": "./src/entries/testing-commands.ts",
    "./testing/property": "./src/entries/testing-property.ts"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./hash": {
        "types": "./dist/hash.d.ts",
        "import": "./dist/hash.js"
      },
      "./math": {
        "types": "./dist/math.d.ts",
        "import": "./dist/math.js"
      },
      "./replay": {
        "types": "./dist/replay.d.ts",
        "import": "./dist/replay.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      },
      "./testing/commands": {
        "types": "./dist/testing-commands.d.ts",
        "import": "./dist/testing-commands.js"
      },
      "./testing/property": {
        "types": "./dist/testing-property.d.ts",
        "import": "./dist/testing-property.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "bench": "AF_BENCH=1 vitest run --project bench",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -p .",
    "test:browser": "vitest run --project browser",
    "test:evidence": "vitest run --project unit --project browser tests/browser/world/snapshot.test.ts tests/browser/testing/bounce.test.ts --reporter=default --reporter=json --outputFile.json=.evidence/goldens.json",
    "build": "tsdown"
  },
  "dependencies": {
    "koota": "0.6.6",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@automata/evidence": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
