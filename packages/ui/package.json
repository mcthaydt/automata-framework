{
  "name": "@mcthaydt/automata-ui",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.svelte"
  ],
  "files": [
    "dist"
  ],
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css",
    "./testing": {
      "default": "./src/testing/index.ts"
    }
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "svelte": "./dist/index.js",
        "import": "./dist/index.js"
      },
      "./theme.css": "./dist/theme.css",
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:layout": "vitest run --project browser",
    "test:browser": "vitest run --project browser",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "svelte-package -i src -o dist --tsconfig tsconfig.package.json && node build/finish-dist.ts"
  },
  "dependencies": {
    "@mcthaydt/automata-content": "workspace:*",
    "@mcthaydt/automata-host": "workspace:*"
  },
  "peerDependencies": {
    "@mcthaydt/automata-testing": "workspace:*",
    "svelte": "^5.57.1"
  },
  "peerDependenciesMeta": {
    "@mcthaydt/automata-testing": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mcthaydt/automata-testing": "workspace:*",
    "@mcthaydt/vitest-preset": "workspace:*",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
