{
  "name": "@mcthaydt/automata-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "svelte": "./src/index.ts",
  "sideEffects": [
    "*.css",
    "*.svelte"
  ],
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:layout": "vitest run --project layout",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@ruken/sdk": "file:../../vendor/ruken/ruken-sdk-0.0.0.tgz"
  },
  "peerDependencies": {
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@mcthaydt/automata-testing": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
