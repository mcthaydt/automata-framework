{
  "name": "@automata/editor",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.svelte"
  ],
  "svelte": "./src/entries/kit.ts",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    "./kit": {
      "svelte": "./src/entries/kit.ts",
      "default": "./src/entries/kit.ts"
    },
    "./kit/core": "./src/entries/kit-core.ts",
    "./kit/documents": "./src/entries/kit-documents.ts",
    "./kit/fields": "./src/entries/kit-fields.ts",
    "./kit/ports": "./src/entries/kit-ports.ts",
    "./kit/ports/testing": "./src/entries/kit-ports-testing.ts",
    "./kit/testing": "./src/entries/kit-testing.ts",
    "./kit/journey-project": "./src/entries/kit-journey-project.ts",
    "./tokens.css": "./src/shared/kit/tokens.css",
    "./tool-chrome.css": "./src/shared/kit/tool-chrome.css",
    "./fonts.css": "./src/shared/kit/fonts.css",
    "./suite": "./src/entries/suite.ts",
    "./suite/testing": "./src/entries/suite-testing.ts",
    "./suite/testing/layout": "./src/entries/suite-layout-testing.ts",
    "./editor-list": "./src/entries/editor-list.ts",
    "./gate-records": "./src/entries/gate-records.ts",
    "./level-export": "./src/entries/level-export.ts",
    "./suite.css": "./src/app/suite/main.css"
  },
  "scripts": {
    "build": "vite build",
    "design:board": "playwright test",
    "dev": "vite",
    "test": "vitest run",
    "test:browser": "vitest run --project parity --project layout --project storage --project canvas --project journeys",
    "test:canvas": "vitest run --project canvas",
    "test:e2e": "playwright test -c playwright.journeys.config.ts",
    "test:journeys": "vitest run --project journeys",
    "test:layout": "vitest run --project layout --project storage",
    "test:unit": "vitest run --project unit",
    "tokens": "node scripts/generate-tokens.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@decimalturn/toml-patch": "3.3.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@automata/framework": "workspace:*",
    "@automata/content": "workspace:*",
    "pixi.js": "8.22.0",
    "smol-toml": "1.9.0",
    "svelte": "5.57.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@automata/playwright-preset": "workspace:*",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@automata/vitest-preset": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "oxc-parser": "0.152.0",
    "playwright": "1.63.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
