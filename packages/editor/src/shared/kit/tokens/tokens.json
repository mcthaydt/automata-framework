{
  "$comment": "Source of truth for the editor tokens. Mirrors the Figma variable collection 'Editor Kit' (https://www.figma.com/design/8H4vY5xZj7xIedrvDdwg2d), mode Dark. the original 3D editor's palette, verbatim. EDK.1 generates tokens.css from this file and a test keeps them equal.",
  "color": {
    "bg": {
      "app": "#111214",
      "surface": "#1a1b1e",
      "raised": "#23252a",
      "field": "#15161a",
      "canvas": "#0a0b0d"
    },
    "border": { "default": "#33363c", "strong": "#454952" },
    "text": { "primary": "#e8e6e1", "dim": "#8e8c85", "faint": "#5f5e5a" },
    "accent": { "default": "#e0a54a", "ink": "#1a1204", "soft": "rgba(224, 165, 74, 0.16)" },
    "state": { "ok": "#6fbf73", "bad": "#d9645a", "warn": "#e6c35c" },
    "layer": {
      "sky": "#6aa8e8",
      "city": "#a58be0",
      "tiles": "#6fbf9a",
      "entities": "#e07a6a",
      "intgrid": "#e6c35c"
    },
    "phase": { "teach": "#5aa9a0", "combine": "#7e8de0", "recover": "#6fbf73", "finish": "#e0734a" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32 },
  "radius": { "sm": 6, "md": 8, "lg": 12, "xl": 16 },
  "size": { "hit": 44, "primary": 48 },
  "font": {
    "sans": "IBM Plex Sans",
    "mono": "IBM Plex Mono",
    "ramp": {
      "display-20": { "family": "sans", "weight": 600, "size": 20, "line": 26, "tracking": 0 },
      "title-15": { "family": "sans", "weight": 600, "size": 15, "line": 20, "tracking": 0 },
      "body-13": { "family": "sans", "weight": 400, "size": 13, "line": 18, "tracking": 0 },
      "body-13-medium": { "family": "sans", "weight": 500, "size": 13, "line": 18, "tracking": 0 },
      "label-12": { "family": "sans", "weight": 500, "size": 12, "line": 16, "tracking": 0 },
      "eyebrow-11": { "family": "sans", "weight": 600, "size": 11, "line": 14, "tracking": 0.9 },
      "mono-12": { "family": "mono", "weight": 400, "size": 12, "line": 16, "tracking": 0 },
      "mono-11": { "family": "mono", "weight": 400, "size": 11, "line": 14, "tracking": 0 }
    }
  }
}
