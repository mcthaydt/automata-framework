{
  "$comment": [
    "The one source of the look shared by the editor and the website. Edit here, then run `pnpm --filter @mcthaydt/automata-editor tokens`; tokens.css is generated and both import it.",
    "tokens: custom property name (without --) to its CSS value, verbatim. The website names come first (the field, paper, ink, cobalt, the chartreuse glow, the flutes and the curtain, the radii, the type steps); then what only the editor needs: a cobalt wash for selections, three state colours that read on paper, the layer and phase colours (projects store the layer names, so they keep theirs), spacing, the 44 and 48 px targets, and the fixed type ramp.",
    "aliases: the editor's names from before the redesign, each the var() of a token, so code not yet moved to the token names takes the new look. They go once nothing reads them.",
    "Where the two sets clashed, the website won: --radius-sm is 12px and --radius-lg 26px, --font-sans and --font-mono are Geist."
  ],
  "colorScheme": "light",
  "tokens": {
    "bg": "#edf1ec",
    "surface": "#e2e9e3",
    "paper": "#f9fbf8",
    "glass": "rgb(255 255 255 / 0.62)",
    "ink": "#11151c",
    "muted": "#434d55",
    "line": "rgb(17 21 28 / 0.09)",
    "line-strong": "rgb(17 21 28 / 0.18)",
    "lime": "#cbf25c",
    "lime-deep": "#8cbf24",
    "cobalt": "#1d278a",
    "cobalt-deep": "#0f1556",
    "teal": "#0f4b49",
    "charcoal": "#16191e",
    "accent": "var(--cobalt)",
    "focus": "var(--cobalt)",
    "stage": "var(--cobalt)",
    "stage-ink": "#eef1fb",
    "stage-muted": "#aab2e0",
    "stage-line": "rgb(255 255 255 / 0.14)",
    "glow": "0 0 0 3px rgb(203 242 92 / 0.22), 0 0 14px rgb(203 242 92 / 0.85)",
    "flutes": "repeating-linear-gradient( 90deg, rgb(255 255 255 / 0.55) 0, rgb(255 255 255 / 0.08) 5px, rgb(20 40 30 / 0.05) 9px, rgb(255 255 255 / 0.55) 12px )",
    "flutes-soft": "repeating-linear-gradient( 90deg, rgb(255 255 255 / 0.3) 0, rgb(255 255 255 / 0.04) 5px, rgb(20 40 30 / 0.025) 9px, rgb(255 255 255 / 0.3) 12px )",
    "flutes-dark": "repeating-linear-gradient( 90deg, rgb(255 255 255 / 0.07) 0, rgb(255 255 255 / 0) 6px, rgb(0 0 0 / 0.14) 10px, rgb(255 255 255 / 0.07) 14px )",
    "curtain": "repeating-linear-gradient( 90deg, rgb(0 0 0 / 0.2) 0, rgb(255 255 255 / 0.045) 46px, rgb(0 0 0 / 0.2) 92px ), repeating-linear-gradient(90deg, rgb(0 0 0 / 0.12) 0, transparent 70px, rgb(0 0 0 / 0.12) 139px)",
    "radius": "18px",
    "radius-lg": "26px",
    "radius-sm": "12px",
    "pill": "999px",
    "font-sans": "\"Geist Variable\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "font-mono": "\"Geist Mono Variable\", ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "step-micro": "0.8125rem",
    "step-small": "1rem",
    "step-body": "1.0625rem",
    "step-lead": "clamp(1.125rem, 1.05rem + 0.3vw, 1.375rem)",
    "step-title": "clamp(1.75rem, 1.2rem + 1.4vw, 2.5rem)",
    "step-head": "clamp(2.25rem, 1.4rem + 2.4vw, 3.5rem)",
    "step-display": "clamp(2.75rem, 1.4rem + 4.4vw, 5.5rem)",
    "gutter": "max(1.25rem, calc((100% - 1280px) / 2))",
    "ease-out": "cubic-bezier(0.22, 1, 0.36, 1)",
    "cobalt-soft": "rgb(29 39 138 / 0.1)",
    "ok": "#1e6b34",
    "bad": "#b42318",
    "warn": "#8a5300",
    "color-layer-sky": "#6aa8e8",
    "color-layer-city": "#a58be0",
    "color-layer-tiles": "#6fbf9a",
    "color-layer-entities": "#e07a6a",
    "color-layer-intgrid": "#e6c35c",
    "color-phase-teach": "#5aa9a0",
    "color-phase-combine": "#7e8de0",
    "color-phase-recover": "#6fbf73",
    "color-phase-finish": "#e0734a",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "24px",
    "space-6": "32px",
    "radius-md": "8px",
    "radius-xl": "16px",
    "size-hit": "44px",
    "size-primary": "48px",
    "text-display-20": "600 20px / 26px var(--font-sans)",
    "text-display-20-tracking": "0px",
    "text-title-15": "600 15px / 20px var(--font-sans)",
    "text-title-15-tracking": "0px",
    "text-body-13": "400 13px / 18px var(--font-sans)",
    "text-body-13-tracking": "0px",
    "text-body-13-medium": "500 13px / 18px var(--font-sans)",
    "text-body-13-medium-tracking": "0px",
    "text-label-12": "500 12px / 16px var(--font-sans)",
    "text-label-12-tracking": "0px",
    "text-eyebrow-11": "600 11px / 14px var(--font-sans)",
    "text-eyebrow-11-tracking": "0.9px",
    "text-mono-12": "400 12px / 16px var(--font-mono)",
    "text-mono-12-tracking": "0px",
    "text-mono-11": "400 11px / 14px var(--font-mono)",
    "text-mono-11-tracking": "0px"
  },
  "aliases": {
    "color-bg-app": "bg",
    "color-bg-surface": "paper",
    "color-bg-raised": "glass",
    "color-bg-field": "paper",
    "color-bg-canvas": "charcoal",
    "color-border-default": "line",
    "color-border-strong": "line-strong",
    "color-text-primary": "ink",
    "color-text-dim": "muted",
    "color-text-faint": "muted",
    "color-accent-default": "cobalt",
    "color-accent-ink": "stage-ink",
    "color-accent-soft": "cobalt-soft",
    "color-state-ok": "ok",
    "color-state-bad": "bad",
    "color-state-warn": "warn"
  }
}
