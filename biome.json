{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!docs/archive",
      "!**/out",
      "!spikes",
      "!**/__goldens__",
      "!tooling/api-index/fixtures",
      "!packages/editor-3d/src/testing/fixtures",
      "!**/*.af2d.json",
      "!games/emberwick/content/generated",
      "!examples/2d/content/hot-reload/content/generated",
      "!site/build",
      "!site/static/demos",
      "!site/static/playground"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "asNeeded" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["packages/sim/**"],
      "linter": { "rules": { "style": { "useExponentiationOperator": "off" } } }
    },
    {
      "includes": [
        "extensions/narrative/**",
        "extensions/puzzle/**",
        "extensions/systems/**",
        "extensions/cutscenes/**"
      ],
      "linter": { "rules": { "suspicious": { "noThenProperty": "off" } } }
    },
    {
      "includes": ["extensions/**/*.svelte"],
      "linter": { "rules": { "correctness": { "noUnusedVariables": "off", "noUnusedImports": "off" } } }
    }
  ]
}
