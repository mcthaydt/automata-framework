{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "concurrency": "4",
  "globalPassThroughEnv": ["VITEST_MAX_WORKERS"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "VENDORED.md"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/tooling/release/src/**", "$TURBO_ROOT$/vendor/ruken/**"]
    },
    "typecheck": {
      "dependsOn": ["@automataframework/figures#typecheck"]
    },
    "@automataframework/figures#typecheck": { "outputs": ["types/**"] },
    "test": {},
    "test:unit": {
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "@automataframework/figures#test:unit": {
      "env": ["AF_UNIT_FULL"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:browser": {
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:journeys": {
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:evidence": {
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "@automataframework/editors#test:e2e": {
      "dependsOn": ["build", "@automataframework/editor#build", "@automataframework/tools#build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "@automataframework/editor#test:e2e": {
      "dependsOn": ["build", "@automataframework/tools#build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
