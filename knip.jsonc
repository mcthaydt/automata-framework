// knip (QB spec §4.1, QB.1): unused files, exports, dependencies and binaries, in `pnpm check`.
// tooling/repo-hygiene/src/knip.test.ts proves it fails on a planted unused export.
{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  // An export its own file uses is not dead code (constants and types that tests also read).
  "ignoreExportsUsedInFile": true,
  // Fixtures are test inputs read as files, never imported.
  "ignore": ["**/fixtures/**", "games/base-3d/src/paraglide/**"],
  // BootErrorIsDrawable is a compile-time assertion (shared contracts §4); exporting it keeps it checked.
  "ignoreIssues": { "packages/automata/src/app/boot/boot-error.ts": ["types"] },
  "workspaces": {
    // DX.7: the plugin's hooks run agents/automata/scripts/check.mjs by path (hooks.json). The automata-feature skill's
    // worked example is skill content that tooling/agent-skills tests (its vitest config lists it and aliases the sim).
    // docs/design (the 3D editor's mock-ups) and docs/archive/design (the 2D editor's, archived) hold mock-up tooling,
    // plain .mjs files run by hand with node, and are not part of any package.
    ".": {
      "entry": ["agents/automata/scripts/check.mjs"],
      "ignore": [
        "agents/automata/skills/*/example/**",
        "docs/design/**",
        "docs/archive/design/**",
        "spikes/**"
      ]
    },
    // DX.7: the example imports @automata/sim, which tooling/agent-skills' vitest config aliases to the source.
    "tooling/agent-skills": { "ignoreDependencies": ["@automata/sim"] },
    // DX.7: the plugin's hook runs Emberwick's own `automata` bin from node_modules/.bin (install.test.ts).
    "games/emberwick": {
      // The journeys sit in tests/e2e; the config names its directory, which knip does not follow.
      "entry": ["playwright.config.ts", "tests/e2e/*.test.ts"],
      "playwright": false
    },
    // Each game or example set has its own playwright.config.ts. They are entries,
    // listed with the journeys they run, because a config's projects name test folders in other workspaces.
    // Each `<module>/<module>-<name>.ts` is a page the examples runner serves, so every one is an entry.
    "examples/2d": {
      "entry": ["playwright.config.ts", "tests/e2e/*.test.ts", "*/*.ts"],
      "playwright": false
    },
    "examples/3d": {
      "entry": ["playwright.config.ts", "tests/e2e/*.test.ts", "*/*.ts"],
      "playwright": false
    },
    // The stories' ship.config.ts is read by `automata ship` by path; the 3D story's journeys are named by its config.
    "examples/2d-story": {
      "entry": ["ship.config.ts", "playwright.config.ts", "tests/e2e/*.test.ts"],
      "playwright": false
    },
    "examples/3d-story": {
      "entry": ["ship.config.ts", "playwright.config.ts", "tests/e2e/*.test.ts"],
      "playwright": false
    },
    "examples/2d/content/hot-reload": { "entry": ["tests/e2e/*.test.ts"], "playwright": false },
    "examples/2d/ui/primitives": { "entry": ["tests/e2e/*.test.ts"], "playwright": false },
    // The site: the compile worker starts from `new URL(...)`, which knip does not follow; the scripts and the playground
    // build run by path (package.json, playwright configs, by hand); the playground's test servers serve
    // playground/static as files.
    "site": {
      "entry": [
        "src/features/playground/compile.worker.ts",
        "scripts/*.ts",
        "playground/*.ts",
        "playwright.config.ts",
        "tests/e2e/*.ts",
        "tests/playground/e2e/*.test.ts"
      ],
      "ignore": ["playground/static/**"],
      // `src/app.css` imports the shared tokens with CSS @import, which knip does not follow.
      "ignoreDependencies": ["@automata/editor"],
      "playwright": false
    },
    // The runner's journeys run from examples/2d's config, which names this folder.
    "tooling/examples-runner": { "entry": ["tests/e2e/*.test.ts"], "playwright": false },
    // Run by hand: `node tooling/codemods/src/cli.ts <package>`, `move-modules-cli.ts`, `rename-scope-cli.ts`.
    "tooling/codemods": { "entry": ["src/cli.ts", "src/move-modules-cli.ts", "src/rename-scope-cli.ts"] },
    // Run by hand on a build made with `vite build --sourcemap`.
    // The editor's pages and entries are what the build and its consumers start from; `src/shared/kit/fonts.css`
    // imports the Geist families with CSS @import, which knip does not follow. `src/app/design/main.ts` is the design
    // board, started from `design.html` by the dev server.
    "packages/editor": {
      "entry": ["src/entries/*.ts", "src/app/*/main.ts", "scripts/*.ts", "tests/e2e/**/*.test.ts"],
      "ignoreDependencies": ["@fontsource-variable/geist", "@fontsource-variable/geist-mono"]
    },
    // `suite.html` starts the full suite page (`vite build --mode suite`), which knip does not read from the HTML.
    "packages/editor-3d": { "entry": ["src/app/suite/suite-main.ts"] },
    // pixi3d-bundle.test.ts builds the fixture page scripts in `src/testing/bundle/` with Vite by path, and nothing
    // imports them. (The goldens' recorder is the package's `goldens` script, which knip reads.)
    "packages/3d": {
      "entry": ["src/testing/bundle/*-entry.ts", "scripts/*.ts"]
    },
    // The bundle tests build the two fixture modules in `src/testing/bundle/` with Vite by path; nothing imports them.
    "extensions/debug": { "entry": ["src/testing/bundle/*.ts"] },
    // Runtime dependencies of the Ruken code that tsdown bundles (@ruken/cli, @ruken/manifest, @ruken/sdk-host).
    // yauzl and yazl are Ruken's, needed at runtime by the code tsdown bundles; smol-toml the tools import themselves.
    "packages/tools": {
      "ignoreDependencies": ["yauzl", "yazl"]
    },
    // PRODUCT.L2: compile-messages.ts loads Paraglide with a dynamic import of a constant and resolves the inlang
    // plugin by name (createRequire().resolve), neither of which knip follows.
    "packages/content": { "ignoreDependencies": ["@inlang/paraglide-js", "@inlang/plugin-message-format"] },
    // The locale test fixture resolves the inlang plugin by name (createRequire().resolve) for its settings file.
    "packages/automata": { "ignoreDependencies": ["@inlang/plugin-message-format"] }
  }
}
