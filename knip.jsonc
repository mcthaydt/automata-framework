// knip (QB spec §4.1, QB.1): unused files, exports, dependencies and binaries, in `pnpm check`.
// tooling/repo-hygiene/src/knip.test.ts proves it fails on a planted unused export.
{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  // An export its own file uses is not dead code (constants and types that tests also read).
  "ignoreExportsUsedInFile": true,
  // Fixtures are test inputs read as files, never imported.
  "ignore": ["**/fixtures/**", "**/kit-fixtures/**"],
  // automata-ship is packages/ship's own bin, which game repositories call through the reusable workflows;
  // flock is a system tool that packages/ship's deploy test uses.
  "ignoreBinaries": ["automata-ship", "flock"],
  // BootErrorIsDrawable is a compile-time assertion (shared contracts §4); exporting it keeps it checked.
  "ignoreIssues": { "packages/runtime/src/boot/boot-error.ts": ["types"] },
  "workspaces": {
    // DX.7: the plugin's hooks run agents/automata/scripts/check.mjs by path (hooks.json). The automata-feature skill's
    // worked example is skill content that tooling/agent-skills tests (its vitest config lists it and aliases the sim).
    // ED.0: docs/design holds the editor mockup tooling, plain .mjs files that are run by hand with node
    // (docs/design/editor-kit/scene/README.md) and are not part of any package.
    ".": {
      "entry": ["agents/automata/scripts/check.mjs"],
      "ignore": ["agents/automata/skills/*/example/**", "docs/design/**"]
    },
    // DX.7: the example imports @mcthaydt/automata-sim, which tooling/agent-skills' vitest config aliases to the source.
    "tooling/agent-skills": { "ignoreDependencies": ["@mcthaydt/automata-sim"] },
    // DX.7: the plugin's hook runs Emberwick's own `automata` bin from node_modules/.bin (install.test.ts).
    "games/emberwick": { "ignoreDependencies": ["@mcthaydt/automata-cli"] },
    // s8/measure.ts builds s8/no-effect.html, whose script is this file.
    "games/placeholder": { "entry": ["s8/no-effect.ts"] },
    // The smoke specs run from the root playwright.config.ts. This workspace loads that config for knip, so the
    // config's patterns count every workspace's e2e files as entries; a workspace's own `test:e2e` script used
    // to do it (`--config=../../../playwright.config.ts`), and the last one went with the demos (EX.4).
    "examples": { "entry": ["e2e/*.e2e.ts"], "playwright": { "config": ["../playwright.config.ts"] } },
    // EDK.1: src/fonts.css imports the IBM Plex families with CSS @import, which knip does not follow.
    "packages/editor-kit": {
      "ignoreDependencies": ["@fontsource/ibm-plex-mono", "@fontsource/ibm-plex-sans"]
    },
    // Runtime dependencies of the Ruken code that tsdown bundles (@ruken/cli, @ruken/manifest, @ruken/sdk-host).
    "packages/ship": { "ignoreDependencies": ["smol-toml", "yauzl", "yazl", "zod"] },
    "packages/host": { "ignoreDependencies": ["zod"] },
    // PRODUCT.L2: compile-messages.ts loads Paraglide with a dynamic import of a constant and resolves the inlang
    // plugin by name (createRequire().resolve), neither of which knip follows.
    "packages/content": { "ignoreDependencies": ["@inlang/paraglide-js", "@inlang/plugin-message-format"] },
    // The locale test fixture resolves the inlang plugin by name (createRequire().resolve) for its settings file.
    "packages/runtime": { "ignoreDependencies": ["@inlang/plugin-message-format"] },
    // automata check (DX.6) bundles @ruken/manifest, which imports smol-toml at runtime.
    "packages/cli": { "ignoreDependencies": ["smol-toml"] },
    // Known unused dependencies on main at QB.1 (2026-10-16), each a follow-up in docs/02 (QB.1 knip
    // baseline). Remove an entry when its follow-up lands; nothing new may be added here without one.
    "examples/runtime/boot-and-flow": {
      "ignoreDependencies": [
        "@mcthaydt/automata-content",
        "@mcthaydt/automata-host",
        "@mcthaydt/automata-ui",
        "koota",
        "@mcthaydt/automata-testing",
        "@ruken/manifest"
      ]
    }
  }
}
