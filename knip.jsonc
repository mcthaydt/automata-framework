// knip (QB spec §4.1, QB.1): unused files, exports, dependencies and binaries, in `pnpm check`.
// tooling/repo-hygiene/src/knip.test.ts proves it fails on a planted unused export.
{
  "$schema": "https://unpkg.com/knip@6.39.0/schema.json",
  // An export its own file uses is not dead code (constants and types that tests also read).
  "ignoreExportsUsedInFile": true,
  // Fixtures are test inputs read as files, never imported.
  // Spikes (spikes/*) are standalone packages outside the pnpm workspace, installed with --ignore-workspace.
  "ignore": ["**/fixtures/**", "spikes/**", "games/base-3d/src/paraglide/**"],
  // BootErrorIsDrawable is a compile-time assertion (shared contracts §4); exporting it keeps it checked.
  "ignoreIssues": { "packages/automata/src/app/boot/boot-error.ts": ["types"] },
  "workspaces": {
    // DX.7: the plugin's hooks run agents/automata/scripts/check.mjs by path (hooks.json). The automata-feature skill's
    // worked example is skill content that tooling/agent-skills tests (its vitest config lists it and aliases the sim).
    // ED.0: docs/design holds the editor mockup tooling, plain .mjs files that are run by hand with node
    // (docs/design/editor-kit/scene/README.md) and are not part of any package.
    ".": {
      "entry": ["agents/automata/scripts/check.mjs"],
      "ignore": ["agents/automata/skills/*/example/**", "docs/design/**"]
    },
    // WEB.PLAY.1: the playground feasibility server serves these browser scripts as files; nothing imports them
    // (tooling/examples-runner, below).
    // DX.7: the example imports @mcthaydt/automata-sim, which tooling/agent-skills' vitest config aliases to the source.
    "tooling/agent-skills": { "ignoreDependencies": ["@mcthaydt/automata-sim"] },
    // DX.7: the plugin's hook runs Emberwick's own `automata` bin from node_modules/.bin (install.test.ts).
    "games/emberwick": {
      // The journeys sit in tests/e2e; the config names its directory, which knip does not follow.
      "entry": ["playwright.config.ts", "tests/e2e/*.test.ts"],
      "playwright": false
    },
    // Each game or example set has its own playwright.config.ts. They are entries,
    // listed with the journeys they run, because a config's projects name test folders in other workspaces.
    "examples": { "entry": ["playwright.config.ts", "tests/e2e/*.test.ts"], "playwright": false },
    "examples/content/hot-reload": { "entry": ["tests/e2e/*.test.ts"], "playwright": false },
    "examples/ui/primitives": { "entry": ["tests/e2e/*.test.ts"], "playwright": false },
    "tooling/examples-runner": {
      "ignore": ["playground/static/**"],
      "entry": ["playwright.config.ts", "tests/e2e/*.test.ts"],
      "playwright": false
    },
    // Run by hand on one package at a time: `node tooling/codemods/src/cli.ts <package>`.
    "tooling/codemods": { "entry": ["src/cli.ts", "src/move-modules-cli.ts"] },
    // Run by hand on a build made with `vite build --sourcemap`.
    "tooling/bundle-report": { "entry": ["src/cli.ts"] },
    // EDK.1: src/fonts.css imports the IBM Plex families with CSS @import, which knip does not follow.
    "packages/editor-kit": {
      "ignoreDependencies": ["@fontsource/ibm-plex-mono", "@fontsource/ibm-plex-sans"]
    },
    // M3.5b: the FigureBuilder goldens' generator is run by hand with node (its header says how).
    "packages/figures": {
      "entry": [
        "scripts/figurebuilder-goldens.ts",
        "scripts/figurebuilder-motion-goldens.ts",
        "scripts/figurebuilder-action-goldens.ts"
      ]
    },
    // Runtime dependencies of the Ruken code that tsdown bundles (@ruken/cli, @ruken/manifest, @ruken/sdk-host).
    // automata check (DX.6) bundles @ruken/manifest, which imports smol-toml at runtime; yauzl and yazl are Ruken's.
    "packages/tools": {
      "ignoreDependencies": ["smol-toml", "yauzl", "yazl"]
    },
    // PRODUCT.L2: compile-messages.ts loads Paraglide with a dynamic import of a constant and resolves the inlang
    // plugin by name (createRequire().resolve), neither of which knip follows.
    "packages/content": { "ignoreDependencies": ["@inlang/paraglide-js", "@inlang/plugin-message-format"] },
    // The locale test fixture resolves the inlang plugin by name (createRequire().resolve) for its settings file.
    "packages/automata": { "ignoreDependencies": ["@inlang/plugin-message-format"] },
    // M3.4a: pixi3d-bundle.test.ts builds these fixture page scripts with Vite by path; nothing imports them.
    "packages/render-pixi3d": { "entry": ["src/bundle/testing/*-entry.ts"] }
  }
}
