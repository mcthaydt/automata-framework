{
  "name": "automata-framework",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.6+sha512.7e1ae66a83a9143c118cc1944f37cc4f2b8acddeda4b001cfa78908f6e46e45e15292739ca6c9d026426cc757e9318cc98c5551d6a16c165097b0028ba87b4e6",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build --filter='./packages/*' --filter=./tooling/check-boundaries",
    "changeset": "changeset",
    "docs:stack": "node tooling/versions/src/write-stack.ts",
    "release:version": "changeset version && node tooling/release/src/sync-versions.ts && pnpm build && pnpm cheatsheet && pnpm agent-skills --write",
    "release": "pnpm build && changeset publish",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-${CI:+2}} turbo run test:unit -- --testTimeout=90000",
    "test:unit:core": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-${CI:+2}} turbo run test:unit --filter='!./packages/editor-*' --filter='!@af-games/base-3d' --filter='!./packages/render-pixi3d' --filter='!./packages/figures' --filter='!./packages/sector-format' -- --testTimeout=90000",
    "test:unit:3d": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-${CI:+2}} turbo run test:unit --filter='./packages/editor-*' --filter='@af-games/base-3d' --filter='./packages/render-pixi3d' --filter='./packages/figures' --filter='./packages/sector-format' -- --testTimeout=90000",
    "bench": "pnpm --recursive --workspace-concurrency=1 --if-present bench",
    "boundaries": "automata-check-boundaries --skip-dir testing packages/sim/src packages/render-pixi3d/src/sim packages/sector-format/src tooling/frame-budget/stress/sim agents/automata/skills/automata-feature/example/src/sim --game games/base-3d/src games/emberwick/src && automata-check-boundaries --inline examples && automata-check-boundaries --platform-imports packages games examples tooling && automata-check-boundaries --features packages/automata packages/sim packages/tools packages/content games/emberwick && automata-check-boundaries --browser packages/content:game-config,locale",
    "style": "node tooling/check-style/src/cli.ts packages/*/src --role-layout games/base-3d/src && node tooling/check-style/src/cli.ts --plan-comments games/emberwick/src packages/automata/src",
    "knip": "knip --no-progress",
    "check": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm style && pnpm knip && pnpm test:unit:core",
    "test:e2e": "turbo run test:e2e",
    "test:frame-budget": "pnpm --filter @mcthaydt/frame-budget exec playwright test",
    "budget:frame": "node tooling/frame-budget/src/check-cli.ts",
    "build:demos": "pnpm --filter \"./examples/*/*\" build",
    "examples": "pnpm --filter @af-examples/examples exec automata-examples dev",
    "build:examples": "pnpm --filter @af-examples/examples build",
    "lint:actions": "docker run --rm -v \"$PWD:/repo\" --workdir /repo rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667 -color",
    "api-report": "node tooling/api-report/src/cli.ts",
    "packs": "node tooling/core-packs/src/cli.ts",
    "api-index": "node tooling/api-index/src/cli.ts",
    "cheatsheet": "node tooling/api-index/src/cli.ts --write-cheatsheet",
    "agent-skills": "node tooling/agent-skills/src/cli.ts",
    "plugin:validate": "pnpm dlx @anthropic-ai/claude-code@2.1.301 plugin validate agents/automata --strict && pnpm dlx @anthropic-ai/claude-code@2.1.301 plugin validate . --strict",
    "test:browser": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-${CI:+2}} turbo run test:browser --concurrency=3 -- --browser.connectTimeout=240000 --testTimeout=90000",
    "test:browser:core": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-${CI:+2}} turbo run test:browser --filter='!./packages/editor-*' --filter='!@af-games/base-3d' --filter='!./packages/render-pixi3d' --filter='!./packages/figures' --filter='!./packages/sector-format' --concurrency=3 -- --browser.connectTimeout=240000 --testTimeout=90000",
    "test:browser:3d": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-${CI:+2}} turbo run test:browser --filter='./packages/editor-*' --filter='@af-games/base-3d' --filter='./packages/render-pixi3d' --filter='./packages/figures' --filter='./packages/sector-format' --concurrency=3 -- --browser.connectTimeout=240000 --testTimeout=90000",
    "test:journeys": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-${CI:+2}} turbo run test:journeys",
    "test:browser:affected": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-${CI:+2}} turbo run test:browser --affected --filter='!./packages/editor-*' --filter='!@af-games/base-3d' --filter='!./packages/render-pixi3d' --filter='!./packages/figures' --filter='!./packages/sector-format' --concurrency=3 -- --browser.connectTimeout=240000 --testTimeout=90000",
    "ci:local": "pnpm install --frozen-lockfile && pnpm check && pnpm test:browser:core && pnpm test:e2e --filter @af-games/emberwick --filter @af-examples/examples",
    "evidence": "VITEST_MAX_WORKERS=${VITEST_MAX_WORKERS:-${CI:+2}} turbo run test:evidence --concurrency=3 -- --browser.connectTimeout=120000 && node tooling/evidence/src/cli.ts",
    "audit:deps": "node tooling/repo-hygiene/src/audit-cli.ts",
    "secrets": "node tooling/repo-hygiene/src/secrets.ts",
    "deps:new": "node tooling/repo-hygiene/src/new-deps-cli.ts",
    "branches:prune": "node tooling/repo-hygiene/src/prune-branches-cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@mcthaydt/automata-check-boundaries": "workspace:*",
    "@playwright/test": "1.63.0",
    "knip": "6.39.0",
    "lefthook": "2.1.16",
    "tsdown": "0.23.0",
    "turbo": "2.11.6",
    "typescript": "7.0.2"
  }
}
