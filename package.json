{
  "name": "@mcthaydt/automata-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node --import tsx scripts/sync-demos.ts && node --import tsx scripts/sync-docs.ts",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "check:site": "node --import tsx scripts/check-site.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.16.1",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "^26.6.5",
    "jsdom": "30.1.1",
    "shiki": "3.1.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "6.4.4",
    "vitest": "5.0.3"
  }
}
