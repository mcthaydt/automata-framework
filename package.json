    "test:parity": "pnpm -r --if-present test:parity",
    "check": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@mcthaydt/automata-check-boundaries": "0.0.3",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
