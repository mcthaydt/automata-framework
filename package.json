{
  "name": "automata-framework",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "boundaries": "node tooling/check-boundaries/src/cli.ts packages/sim/src packages/physics/src",
    "style": "node tooling/check-style/src/cli.ts packages/*/src",
    "check": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm style && pnpm test:unit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.16",
    "turbo": "2.11.6",
    "typescript": "7.0.2"
  }
}
