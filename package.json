{
  "name": "@mcthaydt/automata-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node --import tsx scripts/sync-demos.ts && node --import tsx scripts/sync-docs.ts && node --import tsx scripts/sync-playground.ts",
    "dev": "vite dev",
    "build": "pnpm verify:workshop && pnpm build:workshop && vite build && node --import tsx scripts/write-seo-files.ts build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "check:site": "node --import tsx scripts/check-site.ts",
    "verify:workshop": "vitest run tests/first-change.test.ts tests/double-jump.test.ts --reporter=json --outputFile=.svelte-kit/first-change-results.json && node scripts/record-workshop-proof.mjs",
    "build:workshop": "node scripts/build-workshop.mjs",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "sync:stack": "node --import tsx scripts/sync-stack.ts",
    "sync:evidence": "node --import tsx scripts/sync-evidence.ts",
    "release": "node --import tsx scripts/release.ts",
    "check:deployed": "node --import tsx scripts/check-deployed.ts"
  },
  "dependencies": {
    "@babel/parser": "8.0.10",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "sucrase": "3.35.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.16.1",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "^26.6.5",
    "jsdom": "30.1.1",
    "shiki": "3.1.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vite": "6.4.4",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
