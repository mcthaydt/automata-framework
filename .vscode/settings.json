{
  // What the Owner does not need to see in the file tree or in search: build and test output, generated files,
  // vendored builds and tool config that rarely changes. Nothing here is deleted; it is only hidden.
  // search.exclude (below) repeats the list, so a file hidden from the tree is also left out of search.
  "files.exclude": {
    // Build and install output.
    "**/node_modules": true,
    "**/dist": true,
    "**/.turbo": true,
    "**/.svelte-kit": true,
    "site/build": true,
    "**/.vitest": true,
    // Test and evidence output.
    "**/test-results": true,
    "**/playwright-report*": true,
    "**/.evidence": true,
    "frame-budget-results": true,
    "evidence": true,
    "evidence.json": true,
    "evidence.schema.json": true,
    "**/coverage": true,
    // Generated files: CI checks them and nobody edits them by hand.
    "**/content/generated": true,
    "**/__goldens__": true,
    "tooling/api-report/reports": true,
    "docs/cheatsheet.md": true,
    // Vendored builds and archives.
    "vendor": true,
    "docs/evidence": true,
    "docs/archive": true,
    "docs/provenance": true,
    // Written by tools, or written once.
    "**/CHANGELOG.md": true,
    "**/LICENSE": true,
    "LICENSE-SCOPE.md": true,
    "SECURITY.md": true,
    // Tool config that rarely changes.
    ".changeset": true,
    ".claude-plugin": true,
    ".gitleaks.toml": true,
    ".gitleaksignore": true,
    ".npmrc": true,
    ".nvmrc": true,
    "lefthook.yml": true,
    "renovate.json": true,
    "knip.jsonc": true,
    "turbo.json": true,
    "pnpm-lock.yaml": true,

    // Hidden while the core and 2D refactor runs. Remove when 3D starts.
    "packages/editor-*": true,
    "games/base-3d": true,
    "examples/3d": true,
    "docs/design": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.turbo": true,
    "**/.svelte-kit": true,
    "site/build": true,
    "**/.vitest": true,
    "**/test-results": true,
    "**/playwright-report*": true,
    "**/.evidence": true,
    "frame-budget-results": true,
    "evidence": true,
    "evidence.json": true,
    "evidence.schema.json": true,
    "**/coverage": true,
    "**/content/generated": true,
    "**/__goldens__": true,
    "tooling/api-report/reports": true,
    "docs/cheatsheet.md": true,
    "vendor": true,
    "docs/evidence": true,
    "docs/archive": true,
    "docs/provenance": true,
    "**/CHANGELOG.md": true,
    "**/LICENSE": true,
    "LICENSE-SCOPE.md": true,
    "SECURITY.md": true,
    ".changeset": true,
    ".claude-plugin": true,
    ".gitleaks.toml": true,
    ".gitleaksignore": true,
    ".npmrc": true,
    ".nvmrc": true,
    "lefthook.yml": true,
    "renovate.json": true,
    "knip.jsonc": true,
    "turbo.json": true,
    "pnpm-lock.yaml": true,

    // Hidden while the core and 2D refactor runs. Remove when 3D starts.
    "packages/editor-*": true,
    "games/base-3d": true,
    "examples/3d": true,
    "docs/design": true
  },

  // Format on save the way `pnpm format` does.
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "[svelte]": { "editor.defaultFormatter": "svelte.svelte-vscode" },
  "typescript.tsdk": "node_modules/typescript/lib"
}
