{
  "name": "@automata/ui-screens",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/ui-screens"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "svelte": "./src/entries/index.ts",
      "default": "./src/entries/index.ts"
    },
    "./credits": {
      "svelte": "./src/entries/credits.ts",
      "default": "./src/entries/credits.ts"
    },
    "./error": {
      "svelte": "./src/entries/error.ts",
      "default": "./src/entries/error.ts"
    },
    "./loading": {
      "svelte": "./src/entries/loading.ts",
      "default": "./src/entries/loading.ts"
    },
    "./results": {
      "svelte": "./src/entries/results.ts",
      "default": "./src/entries/results.ts"
    },
    "./splash": {
      "svelte": "./src/entries/splash.ts",
      "default": "./src/entries/splash.ts"
    },
    "./title": {
      "svelte": "./src/entries/title.ts",
      "default": "./src/entries/title.ts"
    },
    "./words/*.json": "./src/shared/words/*.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/entries/index.d.ts",
        "svelte": "./dist/entries/index.js",
        "import": "./dist/entries/index.js"
      },
      "./credits": {
        "types": "./dist/entries/credits.d.ts",
        "svelte": "./dist/entries/credits.js",
        "import": "./dist/entries/credits.js"
      },
      "./error": {
        "types": "./dist/entries/error.d.ts",
        "svelte": "./dist/entries/error.js",
        "import": "./dist/entries/error.js"
      },
      "./loading": {
        "types": "./dist/entries/loading.d.ts",
        "svelte": "./dist/entries/loading.js",
        "import": "./dist/entries/loading.js"
      },
      "./results": {
        "types": "./dist/entries/results.d.ts",
        "svelte": "./dist/entries/results.js",
        "import": "./dist/entries/results.js"
      },
      "./splash": {
        "types": "./dist/entries/splash.d.ts",
        "svelte": "./dist/entries/splash.js",
        "import": "./dist/entries/splash.js"
      },
      "./title": {
        "types": "./dist/entries/title.d.ts",
        "svelte": "./dist/entries/title.js",
        "import": "./dist/entries/title.js"
      },
      "./words/*.json": "./dist/shared/words/*.json"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:parity": "vitest run --project browser",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "svelte-package -i src -o dist --tsconfig tsconfig.package.json && node build/finish-dist.ts"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/content": "workspace:^",
    "@automata/framework": "workspace:^",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@automata/content": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
