{
  "extends": "../../tsconfig.base.json",
  // Node runs the bins straight from source with `--experimental-transform-types`: the core packages they load are
  // TypeScript sources too, and those use parameter properties, which type stripping alone refuses.
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts"]
}
