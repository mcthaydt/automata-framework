{
  "name": "@automata/narrative",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/narrative"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "svelte": "./src/entries/index.ts",
      "default": "./src/entries/index.ts"
    },
    "./sim": "./src/entries/sim.ts",
    "./tools": "./src/entries/tools.ts",
    "./testing/toy-scene.pipe": "./src/testing/toy-scene.pipe.ts",
    "./testing/dead-end-scene.pipe": "./src/testing/dead-end-scene.pipe.ts",
    "./testing/fixtures/*": "./src/testing/fixtures/*"
  },
  "automata": {
    "simEntries": [
      "./sim"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/content": "workspace:^",
    "@automata/framework": "workspace:^",
    "@automata/places": "workspace:^",
    "@automata/puzzle": "workspace:^",
    "@automata/sectors": "workspace:^",
    "@automata/sim": "workspace:^",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@automata/content": "workspace:*",
    "@automata/evidence": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/places": "workspace:*",
    "@automata/puzzle": "workspace:*",
    "@automata/sectors": "workspace:*",
    "@automata/sim": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "smol-toml": "1.9.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
