{
  "name": "@automata/interact",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/interact"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/entries/index.ts",
    "./sim": "./src/entries/sim.ts",
    "./testing/pantry": "./src/testing/pantry.ts"
  },
  "automata": {
    "simEntries": [
      "./sim"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/3d": "workspace:^",
    "@automata/framework": "workspace:^",
    "@automata/nav": "workspace:^",
    "@automata/puzzle": "workspace:^",
    "@automata/sim": "workspace:^"
  },
  "devDependencies": {
    "@automata/3d": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/nav": "workspace:*",
    "@automata/puzzle": "workspace:*",
    "@automata/sectors": "workspace:*",
    "@automata/sim": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@types/node": "24.19.1",
    "vitest": "5.0.3"
  }
}
