{
  "name": "@automataframework/nav",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/nav"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/entries/index.ts",
    "./sim": "./src/entries/sim.ts",
    "./testing/clinic": "./src/testing/clinic.ts"
  },
  "automata": {
    "simEntries": [
      "./sim"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automataframework/content": "workspace:^",
    "@automataframework/framework": "workspace:^",
    "@automataframework/places": "workspace:^",
    "@automataframework/sectors": "workspace:^",
    "@automataframework/sim": "workspace:^"
  },
  "devDependencies": {
    "@automataframework/content": "workspace:*",
    "@automataframework/evidence": "workspace:*",
    "@automataframework/framework": "workspace:*",
    "@automataframework/places": "workspace:*",
    "@automataframework/sectors": "workspace:*",
    "@automataframework/sim": "workspace:*",
    "@automataframework/vitest-preset": "workspace:*",
    "@types/node": "24.19.1",
    "smol-toml": "1.9.0",
    "vitest": "5.0.3"
  }
}
