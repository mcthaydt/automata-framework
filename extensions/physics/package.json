{
  "name": "@automata/physics",
  "version": "0.0.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/physics"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./2d": "./src/entries/2d.ts",
    "./3d": "./src/entries/3d.ts"
  },
  "automata": {
    "simEntries": [
      "./2d",
      "./3d"
    ]
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "exports": {
      "./2d": {
        "types": "./dist/2d.d.ts",
        "import": "./dist/2d.js"
      },
      "./3d": {
        "types": "./dist/3d.d.ts",
        "import": "./dist/3d.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "bench": "AF_BENCH=1 vitest run --project bench",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:evidence": "vitest run --project unit --project browser tests/browser/2d/physics-2d.test.ts tests/browser/3d/physics-3d.test.ts --reporter=default --reporter=json --outputFile.json=.evidence/goldens.json",
    "typecheck": "tsc -p .",
    "build": "tsdown"
  },
  "dependencies": {
    "@dimforge/rapier2d-deterministic-compat": "0.21.0",
    "@dimforge/rapier3d-deterministic-compat": "0.21.0",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/sim": "workspace:^"
  },
  "devDependencies": {
    "@automata/evidence": "workspace:*",
    "@automata/sim": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0",
    "vitest": "5.0.3"
  }
}
