{
  // The painter predates the base's two strictest flags (`noUncheckedIndexedAccess`, `exactOptionalPropertyTypes`) and
  // `isolatedDeclarations`: their findings are counted in the builders-fold plan's ledger, tasks 21 to 27 turn them on
  // folder by folder, and the declarations step (`tsconfig.types.json`) exists only until then.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "resolveJsonModule": true,
    "isolatedDeclarations": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
  },
  "include": ["src", "scripts", "tests", "viewer"]
}
