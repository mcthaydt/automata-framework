{
  "name": "@automata/figures",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "types": "./types/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./kit": {
      "types": "./types/src/kit.d.ts",
      "default": "./src/kit.ts"
    },
    "./view": {
      "types": "./types/src/view.d.ts",
      "default": "./src/view.ts"
    }
  },
  "scripts": {
    "prepare": "tsc -p tsconfig.types.json",
    "typecheck": "tsc -p tsconfig.types.json && tsc --noEmit",
    "test:unit": "vitest run",
    "render": "tsx scripts/render.ts",
    "golden": "tsx scripts/golden.ts",
    "lit": "tsx scripts/lit.ts",
    "actors": "tsx scripts/actors-demo.ts",
    "c5": "tsx scripts/c5-finish-sheet.ts",
    "viewer": "vite viewer",
    "view-check": "tsx scripts/view-check.ts"
  },
  "dependencies": {
    "@pixi/3d": "file:../../vendor/pixi-3d/pixi-3d-0.1.0-beta.2.tgz"
  },
  "peerDependencies": {
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.10",
    "@types/node": "24.19.1",
    "pixi.js": "8.22.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
