{
  "name": "@automata/cutscenes",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/cutscenes"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./sim": "./src/sim/index.ts",
    "./play": "./src/play/index.ts",
    "./tools": "./src/tools/index.ts"
  },
  "automata": {
    "simEntries": [
      "./sim"
    ]
  },
  "scripts": {
    "test": "vitest run --project node --project browsers",
    "test:unit": "vitest run --project node",
    "test:parity": "vitest run --project browsers",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/content": "workspace:^",
    "@automata/framework": "workspace:^",
    "@automata/sectors": "workspace:^",
    "@automata/sim": "workspace:^"
  },
  "devDependencies": {
    "@automata/content": "workspace:*",
    "@automata/evidence": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/narrative": "workspace:*",
    "@automata/nav": "workspace:*",
    "@automata/puzzle": "workspace:*",
    "@automata/sectors": "workspace:*",
    "@automata/sim": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "effect": "3.22.2",
    "playwright": "1.63.0",
    "smol-toml": "1.9.0",
    "vitest": "5.0.3"
  }
}
