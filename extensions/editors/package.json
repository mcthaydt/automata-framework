{
  "name": "@automataframework/editors",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.svelte"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": {
      "svelte": "./src/entries/index.ts",
      "default": "./src/entries/index.ts"
    }
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite --open /suite.html",
    "test": "vitest run",
    "test:e2e": "playwright test -c playwright.journeys.config.ts",
    "test:browser": "vitest run --project layout",
    "test:browser:chromium": "vitest run --project layout --browser.name=chromium",
    "test:unit": "vitest run --project unit",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "dependencies": {
    "@automataframework/audio-synth": "workspace:*",
    "@automataframework/cutscenes": "workspace:*",
    "@automataframework/editor": "workspace:*",
    "@automataframework/feel": "workspace:*",
    "@automataframework/narrative": "workspace:*",
    "@automataframework/nav": "workspace:*",
    "@automataframework/puzzle": "workspace:*",
    "@automataframework/systems": "workspace:*",
    "smol-toml": "1.9.0",
    "svelte": "5.57.1",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automataframework/3d": "workspace:^",
    "@automataframework/content": "workspace:^",
    "@automataframework/framework": "workspace:^",
    "@automataframework/sim": "workspace:^"
  },
  "devDependencies": {
    "@automataframework/playwright-preset": "workspace:*",
    "@automataframework/vitest-preset": "workspace:*",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "@automataframework/3d": "workspace:*",
    "@automataframework/content": "workspace:*",
    "@automataframework/framework": "workspace:*",
    "@automataframework/sim": "workspace:*"
  }
}
