{
  "name": "@automata/character-kit",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Ready-made clothes, hairstyles and seats for AF's procedural 3D figures.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/character-kit"
  },
  "type": "module",
  "sideEffects": [
    "./src/app/*.ts",
    "./src/features/*/register-*.ts"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/entries/index.ts",
    "./testing": "./src/entries/testing.ts"
  },
  "scripts": {
    "goldens": "node --import ../../packages/3d/scripts/extensionless-ts.ts scripts/record-goldens.ts",
    "goldens:core": "node --import ../../packages/3d/scripts/extensionless-ts.ts scripts/record-core-figures.ts",
    "goldens:runway": "tsx scripts/record-runway-cells.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:slow": "vitest run --config vitest.slow.config.ts",
    "test:browser": "vitest run --project browser --project webgpu",
    "test:webgpu": "vitest run --project webgpu",
    "typecheck": "tsc -p .",
    "gate": "tsx scripts/gate.ts"
  },
  "dependencies": {
    "@pixi/3d": "file:../../vendor/pixi-3d/pixi-3d-0.1.0-beta.3.tgz",
    "@automata/figures": "workspace:*",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/3d": "workspace:^",
    "@automata/content": "workspace:^",
    "@automata/framework": "workspace:^",
    "pixi.js": "8.23.0"
  },
  "devDependencies": {
    "@automata/3d": "workspace:*",
    "@automata/content": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "pixi.js": "8.23.0",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
