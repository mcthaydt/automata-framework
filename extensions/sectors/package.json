{
  "name": "@automataframework/sectors",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/sectors"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/entries/index.ts",
    "./sim": "./src/entries/sim.ts",
    "./physics": "./src/entries/physics.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/fixtures/*": "./src/testing/fixtures/*"
  },
  "automata": {
    "simEntries": [
      "./sim",
      "./physics"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automataframework/3d": "workspace:^",
    "@automataframework/framework": "workspace:^",
    "@automataframework/physics": "workspace:^",
    "@automataframework/places": "workspace:^",
    "@automataframework/sim": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@automataframework/physics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@automataframework/3d": "workspace:*",
    "@automataframework/evidence": "workspace:*",
    "@automataframework/framework": "workspace:*",
    "@automataframework/physics": "workspace:*",
    "@automataframework/places": "workspace:*",
    "@automataframework/sim": "workspace:*",
    "@automataframework/vitest-preset": "workspace:*",
    "@types/node": "24.19.1",
    "vitest": "5.0.3"
  }
}
