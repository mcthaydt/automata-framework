{
  "name": "@automata/sectors",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/sectors"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./sim": "./src/sim/index.ts",
    "./physics": "./src/sim/physics/index.ts",
    "./testing/fixtures/*": "./src/testing/fixtures/*"
  },
  "automata": {
    "simEntries": [
      "./sim",
      "./physics"
    ]
  },
  "scripts": {
    "test": "vitest run --project node --project browsers",
    "test:unit": "vitest run --project node",
    "test:parity": "vitest run --project browsers",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/3d": "workspace:^",
    "@automata/content": "workspace:^",
    "@automata/framework": "workspace:^",
    "@automata/physics": "workspace:^",
    "@automata/sim": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@automata/physics": {
      "optional": true
    }
  },
  "devDependencies": {
    "@automata/3d": "workspace:*",
    "@automata/content": "workspace:*",
    "@automata/evidence": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/physics": "workspace:*",
    "@automata/sim": "workspace:*",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0",
    "smol-toml": "1.9.0",
    "vitest": "5.0.3"
  }
}
