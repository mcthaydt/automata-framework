{
  "name": "@automata/net-ui",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/net-ui"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "svelte": "./src/entries/index.ts",
      "default": "./src/entries/index.ts"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/entries/index.d.ts",
        "svelte": "./dist/entries/index.js",
        "import": "./dist/entries/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:parity": "vitest run --project browser",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build": "svelte-package -i src -o dist --tsconfig tsconfig.package.json && node build/finish-dist.ts"
  },
  "peerDependencies": {
    "@automata/framework": "workspace:^",
    "@automata/net": "workspace:^",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@automata/content": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/net": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@sveltejs/package": "3.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "peerDependenciesMeta": {
    "@automata/framework/testing": {
      "optional": true
    }
  }
}
