{
  "name": "@automata/net",
  "version": "0.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/net"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./sim": "./src/sim/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "automata": {
    "simEntries": [
      "./sim"
    ]
  },
  "scripts": {
    "test:unit": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@colyseus/sdk": "0.18.5",
    "effect": "3.22.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/sim": "workspace:^"
  },
  "devDependencies": {
    "@automata/sim": "workspace:*",
    "vitest": "5.0.3"
  }
}
