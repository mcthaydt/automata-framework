  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "An LCD screen look for AF's 3D pixel-art look: a mesh, colour stripes, scanlines, halation and a frame vignette, as a post pass with a settings profile.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/lcd-panel"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "exports": {
    ".": "./src/entries/index.ts",
    "./pass": "./src/entries/pass.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automataframework/3d": "workspace:^",
    "@automataframework/content": "workspace:^",
    "@pixi/3d": "0.1.0-beta.2",
    "pixi.js": "8.22.0"
  },
  "devDependencies": {
    "@automataframework/3d": "workspace:*",
    "@automataframework/content": "workspace:*",
    "@automataframework/framework": "workspace:*",
    "@automataframework/vitest-preset": "workspace:*",
    "@pixi/3d": "file:../../vendor/pixi-3d/pixi-3d-0.1.0-beta.2.tgz",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "pixi.js": "8.22.0",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
