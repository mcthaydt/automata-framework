{
  "name": "@automata/feel",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/feel"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/entries/index.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -p .",
    "build": "tsdown"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/content": "workspace:^",
    "@automata/framework": "workspace:^",
    "@automata/sim": "workspace:^"
  },
  "devDependencies": {
    "@automata/content": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/sim": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@types/node": "24.19.1",
    "smol-toml": "1.9.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
