{
  "name": "@automata/net-server",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/net-server"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "automata-server": "./src/app/automata-server.ts"
  },
  "exports": {
    ".": "./src/entries/index.ts",
    "./testing": "./src/entries/testing.ts"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      }
    },
    "bin": {
      "automata-server": "./dist/automata-server.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -p .",
    "build": "tsdown"
  },
  "dependencies": {
    "@colyseus/core": "0.18.18",
    "@colyseus/schema": "5.0.36",
    "@colyseus/ws-transport": "0.18.4",
    "effect": "3.22.2",
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/net": "workspace:^",
    "@automata/sim": "workspace:^"
  },
  "devDependencies": {
    "@automata/framework": "workspace:*",
    "@automata/net": "workspace:*",
    "@automata/sim": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@colyseus/sdk": "0.18.5",
    "@colyseus/testing": "0.18.6",
    "@colyseus/tools": "0.18.7",
    "@types/node": "24.19.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
