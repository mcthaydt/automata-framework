{
  "name": "@automata/audio-synth",
  "version": "0.0.5",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/audio-synth"
  },
  "type": "module",
  "sideEffects": [
    "./src/features/render/browser.ts",
    "./dist/browser.js"
  ],
  "imports": {
    "#src/*": "./src/*"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/entries/index.ts",
    "./measure": "./src/entries/measure.ts",
    "./render": "./src/entries/render.ts",
    "./browser": "./src/entries/browser.ts",
    "./stage": "./src/entries/stage.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./measure": {
        "types": "./dist/measure.d.ts",
        "import": "./dist/measure.js"
      },
      "./render": {
        "types": "./dist/render.d.ts",
        "import": "./dist/render.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "./stage": {
        "types": "./dist/stage.d.ts",
        "import": "./dist/stage.js"
      }
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc -p .",
    "build": "tsdown"
  },
  "dependencies": {
    "zod": "4.6.6"
  },
  "peerDependencies": {
    "@automata/content": "workspace:^",
    "@automata/feel": "workspace:^",
    "@automata/framework": "workspace:^",
    "@automata/sim": "workspace:^"
  },
  "devDependencies": {
    "@automata/content": "workspace:*",
    "@automata/feel": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/sim": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@types/node": "24.19.1",
    "smol-toml": "1.9.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
