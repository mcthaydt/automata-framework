{
  "name": "@automata/debug",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mcthaydt/automata-framework.git",
    "directory": "extensions/debug"
  },
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#src/*": "./src/*"
  },
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./vite": "./src/vite.ts"
  },
  "scripts": {
    "test": "vitest run --project jsdom --project browsers",
    "test:unit": "vitest run --project jsdom",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:browser": "vitest run --project browsers"
  },
  "peerDependencies": {
    "@automata/audio-synth": "workspace:^",
    "@automata/feel": "workspace:^",
    "@automata/framework": "workspace:^",
    "@automata/sim": "workspace:^",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@automata/audio-synth": "workspace:*",
    "@automata/feel": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/sim": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
