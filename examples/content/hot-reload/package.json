{
  "name": "@af-examples/content-hot-reload",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "test:unit": "vitest run",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "e2e:demo": "vite build --configLoader runner && vite preview --configLoader runner --strictPort --host localhost --port $AF_E2E_DEMO_PORT",
    "e2e:dev": "rm -rf .e2e && mkdir .e2e && cp -R content .e2e/content && AF_DEMO_CONTENT_ROOT=$PWD/.e2e vite --configLoader runner --strictPort --host localhost --port $AF_E2E_DEMO_PORT"
  },
  "dependencies": {
    "@af-examples/base-2d": "workspace:*",
    "@fontsource/pixelify-sans": "5.3.0",
    "@mcthaydt/automata-host": "workspace:*",
    "effect": "3.22.2"
  },
  "devDependencies": {
    "@mcthaydt/examples-runner": "workspace:*",
    "@mcthaydt/automata-content": "workspace:*",
    "@mcthaydt/automata-ship": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "zod": "4.6.6"
  }
}
