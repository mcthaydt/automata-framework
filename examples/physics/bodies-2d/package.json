{
  "name": "@af-examples/physics-bodies-2d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:unit": "vitest run --project node",
    "test:parity": "vitest run --project browsers",
    "test:evidence": "vitest run --project node --project browsers golden.test.ts golden.parity.test.ts --reporter=default --reporter=json --outputFile.json=.evidence/goldens.json",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "e2e:demo": "vite build && vite preview --strictPort --host localhost --port $AF_E2E_DEMO_PORT"
  },
  "dependencies": {
    "@af-examples/base-2d": "workspace:*",
    "@fontsource/pixelify-sans": "5.3.0",
    "@mcthaydt/automata-host": "workspace:*",
    "@mcthaydt/automata-physics": "workspace:*",
    "@mcthaydt/automata-sim": "workspace:*",
    "effect": "3.22.2",
    "pixi.js": "8.21.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@mcthaydt/examples-runner": "workspace:*",
    "@mcthaydt/automata-ship": "workspace:*",
    "@mcthaydt/automata-testing": "workspace:*",
    "@mcthaydt/evidence": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
