{
  "name": "@af-examples/3d-story",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build:web": "vite build --mode web --configLoader runner",
    "build:itch": "vite build --mode itch --configLoader runner",
    "prepare:web": "automata ship prepare --target web",
    "prepare:itch": "automata ship prepare --target itch",
    "typecheck": "tsc -p .",
    "test": "vitest run tests/unit --configLoader runner",
    "check": "pnpm typecheck && pnpm test && automata-check-boundaries --game src",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@automata/3d": "workspace:*",
    "@automata/content": "workspace:*",
    "@automata/debug": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/nav": "workspace:*",
    "@automata/puzzle": "workspace:*",
    "@automata/sectors": "workspace:*",
    "@automata/sim": "workspace:*",
    "@automata/systems": "workspace:*",
    "pixi.js": "8.22.0",
    "svelte": "5.57.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@automata/playwright-preset": "workspace:*",
    "@automata/tools": "workspace:*",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "description": "A small 3D story game: two rooms joined by a doorway and a guard on patrol. The game the served 3D journey of Schematic plays.",
  "imports": {
    "#src/*": "./src/*"
  }
}
