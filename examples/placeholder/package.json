    "@playwright/test": "1.63.0",
    "@ruken/manifest": "file:../../vendor/ruken/ruken-manifest-0.0.0.tgz",
    "@ruken/sdk-host": "file:../../vendor/ruken/ruken-sdk-host-0.0.0.tgz",
    "@types/node": "24.19.1",
    "playwright": "1.63.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
