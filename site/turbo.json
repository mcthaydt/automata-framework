{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  // The API index lists every published package, and the nine free extensions are among them, so the pages, their
  // search and the tests that read the index wait for those builds too (they are not the site's dependencies).
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "@automataframework/physics#build",
        "@automataframework/puzzle#build",
        "@automataframework/feel#build",
        "@automataframework/audio-synth#build",
        "@automataframework/debug#build",
        "@automataframework/net#build",
        "@automataframework/net-server#build",
        "@automataframework/net-ui#build",
        "@automataframework/ui-screens#build"
      ],
      "outputs": ["build/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/guides/**",
        "$TURBO_ROOT$/examples/2d/**",
        "$TURBO_ROOT$/games/emberwick/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/extensions/*/src/**"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "^build",
        "@automataframework/physics#build",
        "@automataframework/puzzle#build",
        "@automataframework/feel#build",
        "@automataframework/audio-synth#build",
        "@automataframework/debug#build",
        "@automataframework/net#build",
        "@automataframework/net-server#build",
        "@automataframework/net-ui#build",
        "@automataframework/ui-screens#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/guides/**",
        "$TURBO_ROOT$/examples/2d/**",
        "$TURBO_ROOT$/games/emberwick/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/extensions/*/src/**"
      ]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    }
  }
}
