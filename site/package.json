{
  "name": "@automata/site",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev",
    "build": "node scripts/build-demos.ts && vite build && node scripts/write-seo-files.ts build && node scripts/write-redirects.ts build && node scripts/scan-closed-beta.ts build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:unit": "node scripts/write-api-index.ts && vitest run",
    "check:site": "node scripts/check-site.ts",
    "check:launch": "node scripts/check-launch.ts",
    "test:e2e": "playwright test",
    "e2e:playground": "node playground/feasibility-server.ts",
    "e2e:playground-frame": "vite build -c playground/vite.config.ts && node playground/frame-server.ts",
    "test:e2e:playground": "playwright test -c playground/playwright.config.ts",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.10",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.4",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@automata/framework": "workspace:*",
    "@automata/editor": "workspace:*",
    "@automata/sim": "workspace:*",
    "@automata/tools": "workspace:*",
    "@ruken/manifest": "file:../vendor/ruken/ruken-manifest-0.0.0.tgz",
    "@ruken/sdk-host": "file:../vendor/ruken/ruken-sdk-host-0.0.0.tgz",
    "effect": "3.22.2",
    "sucrase": "3.35.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@automata/examples-runner": "workspace:*",
    "@automata/playwright-preset": "workspace:*",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.19.1",
    "jsdom": "30.1.1",
    "shiki": "3.1.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
