{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "revision": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": ["sha", "dirty"],
      "additionalProperties": false
    },
    "run": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "ci"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "attempt": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "workflow": {
              "type": "string",
              "minLength": 1
            },
            "job": {
              "type": "string",
              "minLength": 1
            },
            "event": {
              "type": "string",
              "minLength": 1
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["kind", "url", "id", "attempt", "workflow", "job", "event", "ref"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "local"
            }
          },
          "required": ["kind"],
          "additionalProperties": false
        }
      ]
    },
    "playwright": {
      "type": "string",
      "minLength": 1
    },
    "goldens": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "seed": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "ticks": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "enginesAgree": {
            "type": "boolean"
          },
          "sources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "hashes": {
            "minItems": 4,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "engine": {
                  "type": "string",
                  "enum": ["node", "chromium", "firefox", "webkit"]
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              },
              "required": ["engine", "version", "hash"],
              "additionalProperties": false
            }
          }
        },
        "required": ["scenario", "seed", "ticks", "enginesAgree", "sources", "hashes"],
        "additionalProperties": false
      }
    },
    "packages": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "released": {
            "type": "boolean"
          }
        },
        "required": ["name", "version", "released"],
        "additionalProperties": false
      }
    },
    "automataCheck": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "pending"
        },
        "waitingOn": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["status", "waitingOn", "note"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "revision",
    "run",
    "playwright",
    "goldens",
    "packages",
    "automataCheck"
  ],
  "additionalProperties": false
}
