diff --git a/games/the-last-light/tests/e2e/framing.test.ts b/games/the-last-light/tests/e2e/framing.test.ts
new file mode 100644
index 000000000..934162105
--- /dev/null
+++ b/games/the-last-light/tests/e2e/framing.test.ts
@@ -0,0 +1,36 @@
+import { mkdirSync } from 'node:fs'
+import { join } from 'node:path'
+import { test } from '@playwright/test'
+import { passFirstRun } from '@automata/tools/e2e'
+import { stateOf, waitFor } from './driver.ts'
+import { devUrl } from './origins.ts'
+
+// The framing study's shoot: Ada standing facing the camera in the hall, at the query's lens, field, distance, tilt and figure density.
+//   AF_SHOOT=<folder> AF_FRAME='name|lens=70&field=512x384' pnpm --filter @af-games/the-last-light test:e2e --grep framing
+const OUT = process.env.AF_SHOOT
+const FRAMES = (process.env.AF_FRAME ?? '').split(';').filter(Boolean)
+test.skip(OUT === undefined || FRAMES.length === 0, 'set AF_SHOOT and AF_FRAME')
+test.use({ hasTouch: false, isMobile: false, deviceScaleFactor: 1 })
+test.setTimeout(60 * 60_000)
+
+for (const frame of FRAMES) {
+  const [name, query] = frame.split('|') as [string, string]
+  test(`framing ${name}`, async ({ page }) => {
+    await page.setViewportSize({ width: 1024, height: 768 })
+    mkdirSync(OUT as string, { recursive: true })
+    await page.goto(`${devUrl}?${query}`)
+    await passFirstRun(page)
+    await page.getByRole('button', { name: 'Play' }).click()
+    await waitFor(page, { events: 'cutscene.started', atLeast: 1 })
+    await page.getByTestId('cutscene-caption').waitFor({ state: 'visible', timeout: 300_000 })
+    await waitFor(page, { cutscene: null }, 900_000)
+    await waitFor(page, { tickAtLeast: (await stateOf(page)).tick + 20 })
+    // Toward the camera, then still: she faces the lens.
+    await page.keyboard.down('KeyS')
+    await waitFor(page, { tickAtLeast: (await stateOf(page)).tick + 40 })
+    await page.keyboard.up('KeyS')
+    await waitFor(page, { tickAtLeast: (await stateOf(page)).tick + 40 })
+    await page.screenshot({ path: join(OUT as string, `${name}.png`) })
+    console.log(name, JSON.stringify((await stateOf(page)).facts).slice(0, 0))
+  })
+}
