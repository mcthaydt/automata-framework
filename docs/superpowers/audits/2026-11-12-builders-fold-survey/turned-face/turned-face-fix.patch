@@ -81,3 +82,36 @@ describe('eyeTilt', () => {
     for (const d of [0, 1]) expect(diffs(drawn(f, { eyeTilt: 0 }, 1, d).px, drawn(f, { eyeTilt: 1 }, 1, d).px, 64).length, `D1 view ${d}`).toBe(0);
