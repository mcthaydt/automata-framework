{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false,
    // Paraglide's generated src/paraglide is JavaScript typed with JSDoc (G3-t): read for its types, never checked.
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "main.ts",
    "src/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/browser/**/*.ts",
    "content/generated/*.d.ts"
  ],
  // It reads Node-only files (ship.config.ts, package.json); tsconfig.node.json checks it.
  "exclude": ["tests/unit/ship-config.test.ts"]
}
