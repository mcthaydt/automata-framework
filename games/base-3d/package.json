{
  "name": "@af-games/base-3d",
  "version": "0.1.0",
  "private": true,
  "automata": {
    "title": "Ember Hall"
  },
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "sounds": "node scripts/make-sounds.ts",
    "check": "pnpm typecheck && pnpm test:unit && automata-check-boundaries --game src",
    "prepare-ruken": "automata ship prepare --target ruken",
    "test": "vitest run --configLoader runner",
    "test:unit": "vitest run --configLoader runner --project unit",
    "test:browser": "vitest run --configLoader runner --project layout --project sim",
    "test:evidence": "vitest run --configLoader runner --project unit --project sim tests/browser/sim/game.test.ts --reporter=default --reporter=json --outputFile.json=.evidence/goldens.json",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "e2e:game": "VITE_AF_JOURNEYS=1 vite build --configLoader runner && vite preview --configLoader runner --base $AF_E2E_GAME_PATH --strictPort --host localhost --port $AF_E2E_PREVIEW_PORT",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@automata/3d": "workspace:*",
    "@automata/framework": "workspace:*",
    "@automata/sim": "workspace:*",
    "@pixi/3d": "file:../../vendor/pixi-3d/pixi-3d-0.1.0-beta.2.tgz",
    "pixi.js": "8.22.0",
    "svelte": "5.57.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@automata/content": "workspace:*",
    "@automata/editor": "workspace:*",
    "@automata/evidence": "workspace:*",
    "@automata/examples-runner": "workspace:*",
    "@automata/playwright-preset": "workspace:*",
    "@automata/tools": "workspace:*",
    "@automata/vitest-preset": "workspace:*",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
