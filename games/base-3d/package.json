{
  "name": "@af-games/base-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "pnpm typecheck && pnpm test:unit && automata-check-boundaries src",
    "prepare-ruken": "automata-ship prepare",
    "test": "vitest run",
    "test:unit": "vitest run --project node",
    "test:parity": "vitest run --project browsers",
    "test:evidence": "vitest run --project node --project browsers src/game.test.ts --reporter=default --reporter=json --outputFile.json=.evidence/goldens.json",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@mcthaydt/automata-game": "workspace:*",
    "@mcthaydt/automata-render-pixi3d": "workspace:*",
    "@mcthaydt/automata-sim": "workspace:*",
    "effect": "3.22.2",
    "pixi.js": "8.22.0",
    "svelte": "5.57.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@mcthaydt/automata-check-boundaries": "workspace:*",
    "@mcthaydt/automata-ship": "workspace:*",
    "@mcthaydt/evidence": "workspace:*",
    "@ruken/manifest": "file:../../vendor/ruken/ruken-manifest-0.0.0.tgz",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
