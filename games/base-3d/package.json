{
  "name": "@af-games/base-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "vite build --configLoader runner",
    "check": "pnpm typecheck && pnpm test:unit && automata-check-boundaries --game src",
    "prepare-ruken": "automata-ship prepare",
    "test": "vitest run --configLoader runner",
    "test:unit": "vitest run --configLoader runner --project node --project dom",
    "test:parity": "vitest run --configLoader runner --project browsers --project layout",
    "test:evidence": "vitest run --configLoader runner --project node --project browsers src/game.test.ts --reporter=default --reporter=json --outputFile.json=.evidence/goldens.json",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "e2e:game": "vite build --configLoader runner && vite preview --configLoader runner --base $AF_E2E_GAME_PATH --strictPort --host localhost --port $AF_E2E_PREVIEW_PORT"
  },
  "dependencies": {
    "@mcthaydt/automata-figures": "workspace:*",
    "@mcthaydt/automata-game": "workspace:*",
    "@mcthaydt/automata-host": "workspace:*",
    "@mcthaydt/automata-render-pixi3d": "workspace:*",
    "@mcthaydt/automata-runtime": "workspace:*",
    "@mcthaydt/automata-sim": "workspace:*",
    "@mcthaydt/automata-ui": "workspace:*",
    "@pixi/3d": "file:../../vendor/pixi-3d/pixi-3d-0.1.0-beta.2.tgz",
    "effect": "3.22.2",
    "pixi.js": "8.22.0",
    "svelte": "5.57.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@mcthaydt/automata-check-boundaries": "workspace:*",
    "@mcthaydt/automata-content": "workspace:*",
    "@mcthaydt/automata-ship": "workspace:*",
    "@mcthaydt/evidence": "workspace:*",
    "@playwright/test": "1.63.0",
    "@ruken/manifest": "file:../../vendor/ruken/ruken-manifest-0.0.0.tgz",
    "@ruken/sdk-host": "file:../../vendor/ruken/ruken-sdk-host-0.0.0.tgz",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
