{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "isolatedDeclarations": false
  },
  "include": [
    "main.ts",
    "src/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/browser/**/*.ts",
    "fixtures/*.ts",
    "content/generated/*.d.ts"
  ],
  // These read Node-only files (ship.config.ts, the palette file, the game's sources); tsconfig.node.json checks them.
  "exclude": [
    "tests/unit/ship-config.test.ts",
    "tests/unit/vite-config.test.ts",
    "tests/unit/art/art.test.ts",
    "tests/unit/plumbing.test.ts"
  ]
}
