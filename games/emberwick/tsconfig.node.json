{
  // The files that run in Node (Vite, Vitest, Playwright, ship.config.ts) or reach ship's Node code.
  "extends": "./tsconfig.json",
  // vite/client: ship-config.test.ts reads the input map, which reaches the game package's CSS and import.meta.env.
  "compilerOptions": { "types": ["node", "vite/client"] },
  "include": [
    "ship.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/unit/ship-config.test.ts",
    "tests/unit/vite-config.test.ts",
    "tests/unit/art/art.test.ts",
    "tests/unit/plumbing.test.ts",
    "content/generated/content.d.ts",
    "tests/e2e/**/*.ts"
  ],
  "exclude": []
}
